<div class="cart-header">
  <a href="{{ routes.root_url }}" class="cart-header__back" aria-label="Back to home">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
    </svg>
  </a>

  <div class="cart-tabs">
    <button class="cart-tab-btn is-active btn-reset" data-tab="bag">
      YOUR BAG [{{ cart.item_count }}]
    </button>
    <button class="cart-tab-btn btn-reset" data-tab="looks">LOOKS</button>
  </div>
</div>

<!-- Lookbook / Looks tab — images only, 3 columns, for cross-selling (design) -->
<div data-tab-panel="looks" style="display:none">
  {%- assign looks_collection = collections[section.settings.looks_collection] -%}
  {%- unless looks_collection != blank and looks_collection.products_count > 0 -%}
    {%- assign looks_collection = collections[section.settings.suggested_collection] -%}
  {%- endunless -%}
  {%- if looks_collection != blank and looks_collection.products_count > 0 -%}
    <div class="cart-looks">
      {%- for product in looks_collection.products limit: 12 -%}
        <a href="{{ product.url }}" class="cart-looks__item" aria-label="{{ product.title | escape }}">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
            <span class="cart-looks__ph"></span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="cart-empty-page">
      <p class="cart-empty-title">NO LOOKS YET</p>
      <p class="cart-empty-sub">Discover pieces curated for you</p>
      <a href="/collections/all" class="btn cart-empty-cta">DISCOVER WHAT'S NEW</a>
    </div>
  {%- endif -%}
</div>

<!-- Bag tab -->
<div data-tab-panel="bag" class="cart-page">
  {%- if cart.item_count == 0 -%}
    <div class="cart-empty-page">
      <p class="cart-empty-title">YOUR BAG IS EMPTY</p>
      <p class="cart-empty-sub">Explore the latest arrivals and more</p>
      <a href="/collections/all" class="btn cart-empty-cta">VIEW COLLECTION</a>
    </div>

  {%- else -%}
    <div class="cart-layout">

      <!-- Items -->
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <div class="cart-item__img">
              <a href="{{ item.url }}">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 300 }}"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    loading="lazy"
                    width="{{ item.image.width }}"
                    height="{{ item.image.height }}"
                  >
                {%- endif -%}
              </a>
            </div>
            {%- comment -%}Work out which option is Size and which is Colour so we can show
              colour as a text line and Size as a dropdown that swaps the variant.{%- endcomment -%}
            {%- assign size_pos = 0 -%}
            {%- assign color_value = '' -%}
            {%- for option in item.product.options_with_values -%}
              {%- assign on = option.name | downcase -%}
              {%- if option.position == 1 -%}{%- assign opt_val = item.variant.option1 -%}
              {%- elsif option.position == 2 -%}{%- assign opt_val = item.variant.option2 -%}
              {%- else -%}{%- assign opt_val = item.variant.option3 -%}{%- endif -%}
              {%- if on contains 'size' -%}{%- assign size_pos = option.position -%}{%- endif -%}
              {%- if on contains 'colour' or on contains 'color' -%}{%- assign color_value = opt_val -%}{%- endif -%}
            {%- endfor -%}
            {%- if size_pos == 1 -%}{%- assign current_size = item.variant.option1 -%}
            {%- elsif size_pos == 2 -%}{%- assign current_size = item.variant.option2 -%}
            {%- elsif size_pos == 3 -%}{%- assign current_size = item.variant.option3 -%}{%- endif -%}

            <div class="cart-item__details">
              <div class="cart-item__top">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                <button
                  class="cart-item__remove btn-reset"
                  data-remove="{{ item.variant_id }}"
                  aria-label="Remove {{ item.product.title }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>

              {%- comment -%}Color shown above the quantity (size becomes the selector beside qty).{%- endcomment -%}
              {%- if color_value != blank and color_value != 'Default Title' -%}
                <p class="cart-item__color">{{ color_value }}</p>
              {%- endif -%}

              <div class="cart-item__controls">
                <div class="quantity-control">
                  <button class="qty-btn btn-reset" data-variant="{{ item.variant_id }}" data-action="decrease" aria-label="Decrease quantity">−</button>
                  <span class="qty-display">{{ item.quantity }}</span>
                  <button class="qty-btn btn-reset" data-variant="{{ item.variant_id }}" data-action="increase" aria-label="Increase quantity">+</button>
                </div>

                {%- if size_pos > 0 -%}
                  <div class="cart-size-select">
                    <select
                      class="cart-item__size"
                      data-line-variant="{{ item.variant_id }}"
                      data-qty="{{ item.quantity }}"
                      aria-label="Change size"
                    >
                      {%- for v in item.product.variants -%}
                        {%- if size_pos == 1 -%}{%- assign v_size = v.option1 -%}{%- elsif size_pos == 2 -%}{%- assign v_size = v.option2 -%}{%- else -%}{%- assign v_size = v.option3 -%}{%- endif -%}
                        {%- assign v_color = '' -%}
                        {%- for option in item.product.options_with_values -%}
                          {%- assign on2 = option.name | downcase -%}
                          {%- if on2 contains 'colour' or on2 contains 'color' -%}
                            {%- if option.position == 1 -%}{%- assign v_color = v.option1 -%}{%- elsif option.position == 2 -%}{%- assign v_color = v.option2 -%}{%- else -%}{%- assign v_color = v.option3 -%}{%- endif -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if color_value == blank or v_color == color_value -%}
                          <option value="{{ v.id }}"{% if v.id == item.variant_id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v_size }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    <svg class="cart-size-select__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Summary -->
      <aside class="cart-summary">
        <div class="cart-summary-rows">
          <div class="cart-summary-row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary-row cart-summary-row--muted">
            <span>Delivery</span>
            <span>Calculated at checkout</span>
          </div>
        </div>
        <div class="cart-total">
          <div class="cart-total__row">
            <span>TOTAL</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-tax-note">MRP inclusive of all taxes</p>
        </div>
        <a href="{{ routes.cart_url }}/checkout" class="btn btn--full">PROCEED TO CHECKOUT</a>
      </aside>

    </div>
  {%- endif -%}
</div>

<!-- Suggested products -->
{%- assign suggested_collection = collections[section.settings.suggested_collection] -%}
{%- if suggested_collection != blank and suggested_collection.products_count > 0 -%}
  <div class="cart-suggested">
    <h2 class="section-heading cart-suggested__heading">SUGGESTED</h2>
    <div class="product-grid product-grid--4">
      {%- for product in suggested_collection.products limit: 4 -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<style>
/* Lookbook / Looks tab — image-only 3-column grid (no text), for cross-selling */
.cart-looks {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  padding: 4px 24px 64px;
}
@media (min-width: 768px) { .cart-looks { padding: 8px 40px 80px; gap: 2px; } }
.cart-looks__item {
  display: block;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-muted);
}
.cart-looks__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cart-looks__ph { display: block; width: 100%; height: 100%; background: var(--color-muted); }
</style>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "collection",
      "id": "suggested_collection",
      "label": "Suggested products collection"
    },
    {
      "type": "collection",
      "id": "looks_collection",
      "label": "Lookbook collection (LOOKS tab — images only)"
    }
  ]
}
{% endschema %}
