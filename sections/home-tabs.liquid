{%- comment -%}
  HOME / CURATED header — homepage only (mobile).

  Sticky stack (top → down):
    [ announcement bar ]   ← sticky, always visible (see announcement-bar.liquid)
    [ HOME  CURATED   ]    ← THIS header, FIXED right below the announcement bar
    [ hero / content  ]

  States:
    • HOME (default): transparent header, white labels, overlaying the hero.
      Shows the hero + editorial feed.
    • CURATED: white header, black labels. Shows the curated feed (which is
      padded down so it isn't hidden behind the fixed header).
    • Switching tabs flips [data-home-tab] on <html>; background + text colour
      cross-fade over 400ms.

  The header is position:fixed (not sticky) on purpose: the section is wrapped in
  <main>, where a sticky section wrapper is unreliable, so the white CURATED bar
  was scrolling away. Fixed pins it in every state. Everything (markup+CSS+JS)
  lives in this one section so it never depends on a cached/stale theme.css. The
  site-header bar is hidden on the mobile homepage by header.liquid. Desktop is
  unaffected — the tabs are hidden and the homepage renders normally.
{%- endcomment -%}

<div class="home-tabs" id="home-tabs" role="tablist" aria-label="Homepage view">
  <button class="home-tab is-active" data-tab="home" role="tab" aria-selected="true">Home</button>
  <button class="home-tab" data-tab="curated" role="tab" aria-selected="false">Curated</button>
</div>

<style>
  /* Desktop + default: no tabs, and the curated feed is hidden. */
  .home-tabs { display: none; }
  .curated-feed { display: none; }

  @media (max-width: 767px) {
    /* The header bar is fixed, so its section takes no flow space — the hero
       rises to just under the announcement bar and the bar overlays it. */
    #shopify-section-home_tabs { height: 0; }

    .home-tabs {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 32px;
      height: 52px;
      padding: 0 24px;

      /* Pinned just below the (33.5px) sticky announcement bar — stays put while
         scrolling in BOTH HOME and CURATED. */
      position: fixed;
      top: 33px;
      left: 0;
      right: 0;
      z-index: 96;

      background: transparent;                 /* HOME: over the hero */
      transition: background-color 0.4s ease;  /* HOME ⇄ CURATED cross-fade */
    }

    .home-tab {
      position: relative;
      padding: 2px 0;
      border: 0;
      background: none;
      cursor: pointer;
      font-family: var(--font-body, "Helvetica Neue", Helvetica, Arial, sans-serif);
      font-size: 14px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.65);        /* HOME: dimmed white (inactive) */
      transition: color 0.4s ease;
    }
    .home-tab.is-active { color: #ffffff; }     /* HOME: active label */
    .home-tab.is-active::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -6px;
      height: 2px;
      background: currentColor;
      transition: background-color 0.4s ease;
    }

    /* CURATED: white header, dark labels. The header is fixed (out of flow), so
       push the curated feed down by the header height (52px) to clear it. */
    html[data-home-tab="curated"] .home-tabs { background: #ffffff; }
    html[data-home-tab="curated"] .home-tab { color: #999999; }
    html[data-home-tab="curated"] .home-tab.is-active { color: #1a1a1a; }
    html[data-home-tab="curated"] .curated-feed { padding-top: 52px; }

    /* Content swap: HOME shows hero + editorial; CURATED shows the curated feed. */
    html[data-home-tab="curated"] .curated-feed { display: block; }
    html[data-home-tab="curated"] .hero-section,
    html[data-home-tab="curated"] .editorial-banner,
    html[data-home-tab="curated"] .editorial-grid { display: none; }
  }
</style>

<script>
(function () {
  var root = document.documentElement;
  var bar = document.getElementById('home-tabs');
  if (!bar) return;

  // Default to HOME (works even before this runs — HOME is the CSS default).
  if (!root.getAttribute('data-home-tab')) root.setAttribute('data-home-tab', 'home');

  bar.addEventListener('click', function (e) {
    var btn = e.target.closest('.home-tab');
    if (!btn) return;
    root.setAttribute('data-home-tab', btn.getAttribute('data-tab'));
    bar.querySelectorAll('.home-tab').forEach(function (b) {
      var active = b === btn;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    window.scrollTo({ top: 0 });
  });
})();
</script>

{% schema %}
{
  "name": "Home tabs",
  "settings": [],
  "presets": [{ "name": "Home tabs" }]
}
{% endschema %}
