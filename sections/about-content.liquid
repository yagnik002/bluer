<div class="about-page">
  <!-- Mobile: no header/footer/nav — just a back button (design) -->
  <div class="about-topbar">
    <button type="button" class="about-back btn-reset" id="about-back" aria-label="Go back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
    </button>
  </div>

  {%- for block in section.blocks -%}

    {%- if block.type == 'heading' -%}
      <div class="about-heading-block" {{ block.shopify_attributes }}>
        <h2 class="about-heading">{{ block.settings.text }}</h2>
      </div>

    {%- elsif block.type == 'text' -%}
      <div class="about-text-block" {{ block.shopify_attributes }}>
        <p class="about-body">{{ block.settings.text }}</p>
      </div>

    {%- elsif block.type == 'image_full' -%}
      {%- if block.settings.image != blank -%}
        <div class="about-image-full" {{ block.shopify_attributes }}>
          <img
            src="{{ block.settings.image | image_url: width: 1440 }}"
            srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1440 }} 1440w"
            sizes="100vw"
            alt="{{ block.settings.image.alt | default: 'BLUER' }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

    {%- elsif block.type == 'image_pair' -%}
      <div class="about-image-pair" {{ block.shopify_attributes }}>
        {%- if block.settings.image_left != blank -%}
          <img
            src="{{ block.settings.image_left | image_url: width: 800 }}"
            alt="{{ block.settings.image_left.alt | default: 'BLUER' }}"
            loading="lazy"
          >
        {%- endif -%}
        {%- if block.settings.image_right != blank -%}
          <img
            src="{{ block.settings.image_right | image_url: width: 800 }}"
            alt="{{ block.settings.image_right.alt | default: 'BLUER' }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>

    {%- elsif block.type == 'spacer' -%}
      <div class="about-spacer" style="height:{{ block.settings.height | default: 40 }}px" {{ block.shopify_attributes }}></div>

    {%- endif -%}
  {%- endfor -%}
</div>

<style>
.about-page {
  padding-bottom: 80px;
}

.about-heading-block {
  padding: 40px 24px 12px;
  max-width: 760px;
}
@media (min-width: 768px) {
  .about-heading-block { padding: 48px 40px 12px; }
}

.about-heading {
  font-size: 20px;
  letter-spacing: var(--tracking-editorial);
  text-transform: uppercase;
  font-weight: 500;
}

.about-text-block {
  padding: 0 24px 20px;
  max-width: 760px;
}
@media (min-width: 768px) {
  .about-text-block { padding: 0 40px 20px; }
}

.about-body {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.85;
  color: #000000;
}

.about-image-full {
  margin: 28px 0;
}
.about-image-full img {
  width: 100%;
  display: block;
  aspect-ratio: 16/9;
  object-fit: cover;
}
@media (min-width: 768px) {
  .about-image-full img { aspect-ratio: auto; max-height: 600px; object-fit: cover; }
}

/* Mobile type + natural image ratio (design) */
@media (max-width: 767px) {
  .about-heading { font-size: 14px; }
  .about-body { font-size: 12px; letter-spacing: 0.1em; }
  .about-image-full img { aspect-ratio: auto; }
}

.about-image-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin: 28px 0;
}
.about-image-pair img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
}

/* Mobile top bar — back button only (desktop keeps the normal header) */
.about-topbar { display: none; }
.about-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  color: var(--color-fg);
  cursor: pointer;
}
.about-back svg { width: 24px; height: 24px; }

@media (max-width: 767px) {
  .about-topbar { display: flex; align-items: center; padding: 16px 20px 4px; }

  /* This page only: hide the site chrome, leaving just the back button (design) */
  body.template-page-about #shopify-section-announcement-bar,
  body.template-page-about #shopify-section-header,
  body.template-page-about #shopify-section-footer,
  body.template-page-about .mobile-bottom-nav,
  body.template-page-about-us #shopify-section-announcement-bar,
  body.template-page-about-us #shopify-section-header,
  body.template-page-about-us #shopify-section-footer,
  body.template-page-about-us .mobile-bottom-nav { display: none !important; }

  body.template-page-about,
  body.template-page-about-us { padding-bottom: 0 !important; }
}
</style>

<script>
(function () {
  var btn = document.getElementById('about-back');
  if (!btn) return;
  btn.addEventListener('click', function () {
    if (history.length > 1) history.back();
    else window.location.href = '/';
  });
})();
</script>

{% schema %}
{
  "name": "About content",
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "THE FOUNDATION"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Paragraph text",
          "default": "Add your paragraph here."
        }
      ]
    },
    {
      "type": "image_full",
      "name": "Full-width image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "image_pair",
      "name": "Two-column images",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_left",
          "label": "Left image"
        },
        {
          "type": "image_picker",
          "id": "image_right",
          "label": "Right image"
        }
      ]
    },
    {
      "type": "spacer",
      "name": "Spacer",
      "settings": [
        {
          "type": "range",
          "id": "height",
          "label": "Height (px)",
          "min": 16,
          "max": 120,
          "step": 8,
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About content"
    }
  ]
}
{% endschema %}
