{%- if section.settings.layout == 'full' -%}
  {%- assign tag1 = 'div' -%}
  {%- if section.settings.link_1 != blank -%}{%- assign tag1 = 'a' -%}{%- endif -%}
  <{{ tag1 }} class="editorial-banner"{% if section.settings.link_1 != blank %} href="{{ section.settings.link_1 }}"{% endif %}>
    {%- if section.settings.image_1 != blank -%}
      <img
        src="{{ section.settings.image_1 | image_url: width: 1920 }}"
        srcset="{{ section.settings.image_1 | image_url: width: 800 }} 800w, {{ section.settings.image_1 | image_url: width: 1440 }} 1440w, {{ section.settings.image_1 | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ section.settings.image_1.alt | default: section.settings.label_1 }}"
        loading="lazy"
      >
    {%- else -%}
      <div style="width:100%;height:88vh;background:var(--color-muted)"></div>
    {%- endif -%}
    {%- if section.settings.label_1 != blank -%}
      <p class="hero-label{% if section.settings.label_dark %} hero-label--dark{% endif %}">{{ section.settings.label_1 }}</p>
    {%- endif -%}
  </{{ tag1 }}>

{%- elsif section.settings.layout == 'two-col' -%}
  <div class="editorial-grid">
    {%- assign ctag1 = 'div' -%}
    {%- if section.settings.link_1 != blank -%}{%- assign ctag1 = 'a' -%}{%- endif -%}
    <{{ ctag1 }} class="editorial-grid__cell"{% if section.settings.link_1 != blank %} href="{{ section.settings.link_1 }}"{% endif %}>
      {%- if section.settings.image_1 != blank -%}
        <img src="{{ section.settings.image_1 | image_url: width: 960 }}" alt="{{ section.settings.image_1.alt | default: section.settings.label_1 }}" loading="lazy">
      {%- else -%}
        <div style="aspect-ratio:4/5;background:var(--color-muted)"></div>
      {%- endif -%}
      {%- if section.settings.label_1 != blank -%}<p class="hero-label{% if section.settings.label_dark %} hero-label--dark{% endif %}">{{ section.settings.label_1 }}</p>{%- endif -%}
    </{{ ctag1 }}>

    {%- assign ctag2 = 'div' -%}
    {%- if section.settings.link_2 != blank -%}{%- assign ctag2 = 'a' -%}{%- endif -%}
    <{{ ctag2 }} class="editorial-grid__cell"{% if section.settings.link_2 != blank %} href="{{ section.settings.link_2 }}"{% endif %}>
      {%- if section.settings.image_2 != blank -%}
        <img src="{{ section.settings.image_2 | image_url: width: 960 }}" alt="{{ section.settings.image_2.alt | default: section.settings.label_2 }}" loading="lazy">
      {%- else -%}
        <div style="aspect-ratio:4/5;background:var(--color-muted)"></div>
      {%- endif -%}
      {%- if section.settings.label_2 != blank -%}<p class="hero-label{% if section.settings.label_dark %} hero-label--dark{% endif %}">{{ section.settings.label_2 }}</p>{%- endif -%}
    </{{ ctag2 }}>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Editorial block",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "Full-width banner" },
        { "value": "two-col", "label": "Two-column grid" }
      ],
      "default": "full"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Image 1 corner label (editable title)"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Image 1 link"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (two-column only)"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Image 2 corner label (editable title)"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Image 2 link"
    },
    {
      "type": "checkbox",
      "id": "label_dark",
      "label": "Dark corner labels (for light images)",
      "default": false
    }
  ],
  "presets": [
    { "name": "Editorial block" }
  ]
}
{% endschema %}
