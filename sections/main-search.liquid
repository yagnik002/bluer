<div class="search-page">



  {%- if search.performed and search.terms != blank -%}
    {%- if search.results_count > 0 -%}
      <p class="search-page__label">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="search-page__label">No results for "{{ search.terms }}"</p>
      <p class="search-page__empty">Try a different search, or explore what's featured below.</p>
    {%- endif -%}
  {%- endif -%}

  {%- unless search.performed and search.results_count > 0 -%}
    {%- if section.settings.recommended_terms != blank -%}
      <p class="search-page__label">Recommended</p>
      <ul class="search-page__recommended">
        {%- assign terms = section.settings.recommended_terms | split: ',' -%}
        {%- for term in terms -%}
          {%- assign t = term | strip -%}
          {%- if t != blank -%}
            <li><a href="{{ routes.search_url }}?q={{ t | url_encode }}&type=product">{{ t }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign featured = collections[section.settings.featured_collection] -%}
    {%- if featured != blank and featured.products_count > 0 -%}
      <p class="search-page__label">Featured</p>
      <div class="search-featured">
        {%- for product in featured.products limit: 6 -%}
          <a href="{{ product.url }}" class="search-featured__item">
            <div class="search-featured__strip">
              {%- for image in product.images limit: 3 -%}
                <span class="search-featured__img"><img src="{{ image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy"></span>
              {%- else -%}
                {%- if product.featured_image -%}
                  <span class="search-featured__img"><img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="search-featured__title">{{ product.title }}</p>
            <p class="search-featured__price">{{ product.price | money }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endunless -%}

</div>

<style>
.search-page { padding: 32px 24px 80px; animation: search-blend-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
@media (min-width: 768px) { .search-page { padding: 40px 0px 0px; } }

/* Open the search page with a smooth fade + slide-down */
@keyframes search-blend-in {
  from { opacity: 0; transform: translateY(-26px); }
  to   { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .search-page { animation: none; }
}

/* Editorial "SEARCH ___" field with a blinking caret (the only on-page search) */
.search-page__form { margin-bottom: 8px; }
.search-editorial {
  display: flex;
  align-items: baseline;
  gap: clamp(16px, 3vw, 32px);
  max-width: 680px;
}
.search-editorial__label,
.search-editorial__input {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: clamp(16px, 2.4vw, 22px);
  line-height: 1.1;
  color: var(--color-fg);
}
.search-editorial__label {
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  white-space: nowrap;
}
.search-editorial__input {
  flex: 1;
  min-width: 0;
  border: none;
  border-bottom: 1.5px solid var(--color-fg);
  background: transparent;
  outline: none;
  letter-spacing: 0.04em;
  padding: 0 0 8px;
  caret-color: var(--color-fg);
  -webkit-appearance: none;
  appearance: none;
}
/* Hide the browser's native clear (×) button on the search field */
.search-editorial__input::-webkit-search-cancel-button,
.search-editorial__input::-webkit-search-decoration { -webkit-appearance: none; appearance: none; display: none; }

.search-page__label {
  /* Figma 1:486/1:487 — RECOMMENDED/FEATURED: Helvetica Neue Medium 16px, tracking 1.6px (0.1em) */
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000000;
  margin: 32px 0 14px;
}
.search-page__label:first-child { margin-top: 0; padding: 0px 40px 0px; }

/* Recommended suggestions with divider lines */
.search-page__recommended {
  display: flex;
  flex-direction: column;
  margin-bottom: 8px;
  padding: 10px 40px 10px;
}
.search-page__recommended a {
  /* Figma 1:466-468 — Helvetica Neue Regular 16px, #969696, tracking 1.6px (0.1em) */
  display: block;
  font-size: 16px;
  letter-spacing: 0.1em;
  color: #969696;
  padding: 14px 0;
  border-bottom: 1px solid var(--color-border);
  transition: color var(--transition);
}
.search-page__recommended a:hover { color: var(--color-fg); }

/* Featured: each product as a 3-image strip + name + price */
.search-featured { display: flex; flex-direction: column; gap: 28px; }
.search-featured__item { display: block; }
.search-featured__strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.search-featured__img { display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--color-muted); }
.search-featured__img img { width: 100%; height: 100%; object-fit: cover; }
.search-featured__title {
  font-size: 12px;
  letter-spacing: var(--tracking-editorial);
  text-transform: uppercase;
  margin-top: 12px;
}
.search-featured__price { font-size: 12px; color: var(--color-muted-fg); margin-top: 4px; }

.search-page__empty { font-size: 14px; color: var(--color-muted-fg); margin-top: 8px; }
</style>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "recommended_terms",
      "label": "Recommended search terms (comma-separated)",
      "default": "Dresses, Denim, Tops, New Arrivals"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured products (shown before searching)"
    }
  ]
}
{% endschema %}
