<div class="search-page">

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <div class="search-box">
      <svg class="search-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.placeholder | default: 'Search' }}"
        class="search-box__input"
        autocomplete="off"
        aria-label="Search"
        autofocus
      >
      <button type="button" class="search-box__mic btn-reset" aria-label="Voice search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z"/></svg>
      </button>
    </div>
    <input type="hidden" name="type" value="product">
  </form>

  {%- if search.performed and search.terms != blank -%}
    {%- if search.results_count > 0 -%}
      <p class="search-page__label">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="search-page__label">No results for "{{ search.terms }}"</p>
      <p class="search-page__empty">Try a different search, or explore what's featured below.</p>
    {%- endif -%}
  {%- endif -%}

  {%- unless search.performed and search.results_count > 0 -%}
    {%- if section.settings.recommended_terms != blank -%}
      <p class="search-page__label">Recommended</p>
      <ul class="search-page__recommended">
        {%- assign terms = section.settings.recommended_terms | split: ',' -%}
        {%- for term in terms -%}
          {%- assign t = term | strip -%}
          {%- if t != blank -%}
            <li><a href="{{ routes.search_url }}?q={{ t | url_encode }}&type=product">{{ t }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign featured = collections[section.settings.featured_collection] -%}
    {%- if featured != blank and featured.products_count > 0 -%}
      <p class="search-page__label">Featured</p>
      <div class="search-featured">
        {%- for product in featured.products limit: 6 -%}
          <a href="{{ product.url }}" class="search-featured__item">
            <div class="search-featured__strip">
              {%- for image in product.images limit: 3 -%}
                <span class="search-featured__img"><img src="{{ image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy"></span>
              {%- else -%}
                {%- if product.featured_image -%}
                  <span class="search-featured__img"><img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="search-featured__title">{{ product.title }}</p>
            <p class="search-featured__price">{{ product.price | money }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endunless -%}

</div>

<style>
.search-page { padding: 32px 24px 80px; }
@media (min-width: 768px) { .search-page { padding: 40px 40px 100px; } }

.search-page__form { margin-bottom: 8px; }

/* Filled search pill with magnifier + mic (mobile design) */
.search-box {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--color-muted);
  border-radius: 6px;
  padding: 12px 14px;
}
.search-box__icon { width: 20px; height: 20px; color: var(--color-fg); flex-shrink: 0; }
.search-box__input {
  flex: 1;
  min-width: 0;
  border: none;
  background: transparent;
  outline: none;
  font-size: 15px;
  letter-spacing: 0.02em;
  color: var(--color-fg);
}
.search-box__input::placeholder { color: var(--color-muted-fg); }
.search-box__mic { display: inline-flex; color: var(--color-fg); }
.search-box__mic svg { width: 20px; height: 20px; }

.search-page__label {
  font-size: 12px;
  letter-spacing: var(--tracking-editorial);
  text-transform: uppercase;
  color: var(--color-fg);
  margin: 32px 0 14px;
}

/* Recommended suggestions with divider lines */
.search-page__recommended {
  display: flex;
  flex-direction: column;
  margin-bottom: 8px;
}
.search-page__recommended a {
  display: block;
  font-size: 15px;
  color: var(--color-muted-fg);
  padding: 14px 0;
  border-bottom: 1px solid var(--color-border);
  transition: color var(--transition);
}
.search-page__recommended a:hover { color: var(--color-fg); }

/* Featured: each product as a 3-image strip + name + price */
.search-featured { display: flex; flex-direction: column; gap: 28px; }
.search-featured__item { display: block; }
.search-featured__strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.search-featured__img { display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--color-muted); }
.search-featured__img img { width: 100%; height: 100%; object-fit: cover; }
.search-featured__title {
  font-size: 12px;
  letter-spacing: var(--tracking-editorial);
  text-transform: uppercase;
  margin-top: 12px;
}
.search-featured__price { font-size: 12px; color: var(--color-muted-fg); margin-top: 4px; }

.search-page__empty { font-size: 14px; color: var(--color-muted-fg); margin-top: 8px; }
</style>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "recommended_terms",
      "label": "Recommended search terms (comma-separated)",
      "default": "Dresses, Denim, Tops, New Arrivals"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured products (shown before searching)"
    }
  ]
}
{% endschema %}
