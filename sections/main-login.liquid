<div class="login-page">
  <div class="login-card">
    <h1 class="login-heading">ACCESS</h1>
    <p class="login-sub">Log in or create an account to enjoy a more convenient and faster shopping experience.</p>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div class="form-errors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-field">
        <input
          class="form-input form-input--gray"
          type="email"
          name="customer[email]"
          id="customer_email"
          placeholder="Email Address"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
      </div>

      <div class="form-field">
        <input
          class="form-input form-input--gray"
          type="password"
          name="customer[password]"
          id="customer_password"
          placeholder="Password"
          autocomplete="current-password"
          required
        >
      </div>

      <div class="login-actions">
        <button type="submit" class="btn btn--full login-btn">CONTINUE</button>
        <a href="{{ routes.account_recover_url }}" class="login-link">Forgot password?</a>
        <a href="{{ routes.account_register_url }}" class="login-link">Create account</a>
      </div>

      <p class="login-terms">By continuing, you agree to our <a href="/pages/terms-and-conditions">Terms &amp; Conditions</a> and <a href="/pages/privacy-policy">Privacy Policy</a></p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
