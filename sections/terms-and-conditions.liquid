<div class="policy-page policy-page--terms">
  <div class="policy-page__inner">

    <h1 class="policy-page__title">{{ section.settings.title | default: page.title }}</h1>

    {%- if section.settings.intro != blank -%}
      <p class="policy-page__intro">{{ section.settings.intro | newline_to_br }}</p>
    {%- endif -%}

    <div class="policy-body">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          <h2 class="policy-section-heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

        {%- elsif block.type == 'text' -%}
          <p class="policy-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

        {%- elsif block.type == 'list' -%}
          <ul class="policy-list" {{ block.shopify_attributes }}>
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                <li>{{ trimmed }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

        {%- elsif block.type == 'divider' -%}
          <hr class="policy-divider" {{ block.shopify_attributes }}>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 and page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
.policy-page--terms {
  --terms-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-family: var(--terms-font);
  color: #000;
}
@media (min-width: 768px) { .policy-page--terms { padding-top: 105px; } }
.policy-page--terms .policy-page__inner { max-width: 1096px; }

.policy-page--terms .policy-page__title {
  font-family: var(--terms-font);
  font-size: 16px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin-bottom: 20px;
}

.policy-page--terms .policy-page__intro,
.policy-page--terms .policy-text,
.policy-page--terms .policy-list li,
.policy-page--terms .rte p,
.policy-page--terms .rte li {
  font-family: var(--terms-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  color: #000;
}
.policy-page--terms .policy-page__intro { max-width: none; }

.policy-page--terms .policy-body { margin-top: 0; }
.policy-page--terms .policy-section-heading,
.policy-page--terms .rte h2 {
  font-family: var(--terms-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin: 50px 0 25px;
}
.policy-page--terms .policy-section-heading:first-child { margin-top: 50px; }

.policy-page--terms .policy-text,
.policy-page--terms .rte p { margin-bottom: 25px; }
.policy-page--terms .policy-list,
.policy-page--terms .rte ul,
.policy-page--terms .rte ol { padding-left: 20px; margin-bottom: 25px; list-style: disc; }
.policy-page--terms .policy-list li,
.policy-page--terms .rte li { margin-bottom: 0; }

.policy-page--terms .policy-divider { border: none; border-top: 1px solid var(--color-border); margin: 32px 0; }
</style>

{% schema %}
{
  "name": "Terms and Conditions",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title (leave blank to use Shopify page title)"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Section heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "list",
      "name": "Bullet list",
      "settings": [
        {
          "type": "textarea",
          "id": "items",
          "label": "List items (one per line)"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    }
  ],
  "presets": [
    { "name": "Terms and Conditions" }
  ]
}
{% endschema %}