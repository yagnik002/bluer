<section class="hero-section">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | default: shop.name }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <div style="width:100%;height:88vh;background:var(--color-muted)"></div>
  {%- endif -%}

  {%- if section.settings.title != blank -%}
    <h1 class="hero-title font-display" aria-label="{{ section.settings.title }}">
      {{ section.settings.title }}
    </h1>
  {%- endif -%}

  {%- if section.settings.label != blank -%}
    <p class="hero-label">{{ section.settings.label }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Overlay title",
      "default": "BLUER"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Corner label",
      "default": "CRAFTE"
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
