<section class="hero-section">
  {%- comment -%}Black intro screen — fades out ~1.5s after load to reveal the banner.{%- endcomment -%}
  <div class="hero-intro" id="hero-intro">
    {%- comment -%}Splash logo: use the white logo image (logo_light); fall back to the
       header logo asset inverted to white. The black screen fades out after load.{%- endcomment -%}
    {%- if settings.logo_light != blank -%}
      <img class="hero-intro__logo-img" src="{{ settings.logo_light | image_url: width: 900 }}" alt="{{ shop.name }}">
    {%- else -%}
      <img class="hero-intro__logo-img hero-intro__logo-img--invert" src="{{ 'bluer-logo-for-not-home-page-header-logo.png' | asset_url }}" alt="{{ shop.name }}">
    {%- endif -%}
  </div>

  {%- comment -%}Whole banner is clickable when a link is set (titles/labels stay editable above).{%- endcomment -%}
  {%- if section.settings.link != blank -%}
    <a class="hero-link" href="{{ section.settings.link }}" aria-label="{{ section.settings.label | default: section.settings.title | default: shop.name }}"></a>
  {%- endif -%}

  {%- if section.settings.video != blank -%}
    <video
      class="hero-media"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}
      aria-label="{{ section.settings.title | default: shop.name }}"
    >
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>

    <button class="hero-mute" id="hero-mute" type="button" aria-label="Unmute video" aria-pressed="false">
      <svg class="hero-mute__icon hero-mute__muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z"/><line stroke-linecap="round" x1="23" y1="9" x2="17" y2="15"/><line stroke-linecap="round" x1="17" y1="9" x2="23" y2="15"/></svg>
      <svg class="hero-mute__icon hero-mute__unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14"/></svg>
    </button>
  {%- elsif section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | default: shop.name }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <div class="hero-placeholder"></div>
  {%- endif -%}

  <h1 class="hero-logo" id="hero-logo">
    {%- if settings.logo_light != blank -%}
      <img src="{{ settings.logo_light | image_url: width: 900 }}" alt="{{ section.settings.title | default: shop.name }}">
    {%- elsif settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 900 }}" alt="{{ section.settings.title | default: shop.name }}">
    {%- else -%}
      <span class="font-display">{{ section.settings.title | default: shop.name }}</span>
    {%- endif -%}
  </h1>

  {%- if section.settings.label != blank -%}
    <p class="hero-label">{{ section.settings.label }}</p>
  {%- endif -%}
</section>

<style>
/* Black intro screen — covers the hero on first paint, then dissolves to reveal it */
.hero-intro {
  position: absolute;
  inset: 0;
  z-index: 200;
  background: #000;
  display: grid;
  place-items: center;
  opacity: 1;
  transition: opacity 0.8s ease;
}
.hero-intro.is-hidden { opacity: 0; pointer-events: none; }
.hero-intro__logo {
  color: #fff;
  font-size: 48px;
  letter-spacing: var(--tracking-logo);
  line-height: 1;
}
@media (min-width: 768px) { .hero-intro__logo { font-size: 72px; } }
/* Splash logo image (white BLUER wordmark on the black intro screen).
   Matches the centred hero logo size so it stays put as the splash fades. */
.hero-intro__logo-img { display: block; height: 35rem; width: auto; max-width: 80vw; }
@media (max-width: 767px) { .hero-intro__logo-img { height: 33rem; } }
.hero-intro__logo-img--invert { filter: invert(1); } /* header asset is dark — flip to white */
@media (prefers-reduced-motion: reduce) {
  .hero-intro { transition: none; }
}

/* Clickable banner overlay (sits above the video, below the logo/label/mute controls) */
.hero-link { position: absolute; inset: 0; z-index: 80; display: block; }

/* Mute / unmute toggle — bottom-right of the hero */
.hero-mute {
  position: absolute;
  right: 18px;
  bottom: 20px;
  z-index: 95;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.9);
  cursor: pointer;
  transition: opacity var(--transition);
}
@media (min-width: 768px) { .hero-mute { right: 36px; bottom: 36px; } }
.hero-mute:hover { opacity: 0.7; }
.hero-mute__icon { width: 22px; height: 22px; }
.hero-mute__unmuted { display: none; }
.hero-mute.is-unmuted .hero-mute__muted { display: none; }
.hero-mute.is-unmuted .hero-mute__unmuted { display: block; }

/* Centred hero logo — fades out once the hero is scrolled past (.home-scrolled set by header JS) */
.hero-logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 90;
  margin: 0;
  line-height: 1;
  text-align: center;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.3s ease;
}
.home-scrolled .hero-logo { opacity: 0; }

.hero-logo img {
  display: block;
  height: 38rem; /* desktop hero logo height */
  width: auto;
  max-width: 80vw;
}
/* Mobile only: smaller centred hero logo (per request). */
@media (max-width: 767px) {
  .hero-logo img { height: 33rem; }
}
.hero-logo .font-display {
  color: #fff;
  font-size: 48px;
  letter-spacing: var(--tracking-logo);
}
@media (min-width: 768px) {
  .hero-logo .font-display { font-size: 96px; }
}

/* Full-frame hero video */
.hero-section video.hero-media {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  object-fit: cover;
  display: block;
}
.hero-section .hero-placeholder {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  background: var(--color-muted);
}

/* Mobile only: hero is shorter (82vh) so the next section peeks below it.
   Desktop keeps the full-screen 100dvh hero. */
@media (max-width: 767px) {
  .hero-section video.hero-media,
  .hero-section .hero-placeholder {
    height: 82vh;
    width: 100%;
  }
}
</style>

<script>
(function () {
  function init() {
    // Dissolve the black intro screen shortly after load (1–2s, per design)
    var intro = document.getElementById('hero-intro');
    if (intro) {
      window.setTimeout(function () { intro.classList.add('is-hidden'); }, 1400);
      intro.addEventListener('transitionend', function () {
        if (intro.parentNode) intro.parentNode.removeChild(intro);
      });
    }

    // Mute / unmute toggle for the hero video
    var btn = document.getElementById('hero-mute');
    var video = document.getElementById('hero-video');
    if (btn && video) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        video.muted = !video.muted;
        var unmuted = !video.muted;
        btn.classList.toggle('is-unmuted', unmuted);
        btn.setAttribute('aria-pressed', String(unmuted));
        btn.setAttribute('aria-label', unmuted ? 'Mute video' : 'Unmute video');
        if (unmuted) { video.play().catch(function () {}); }
      });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else { init(); }
})();
</script>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hero video (autoplays muted, loops)",
      "info": "Upload an MP4. When set, it replaces the hero image. Use the image below as the poster/fallback."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link (makes the whole banner clickable)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (also used as video poster / fallback)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Overlay title",
      "default": "BLUER"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Corner label",
      "default": "CRAFTE"
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
