<section class="hero-section">
  {%- if section.settings.video != blank -%}
    <video
      class="hero-media"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}
      aria-label="{{ section.settings.title | default: shop.name }}"
    >
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- elsif section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | default: shop.name }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <div class="hero-placeholder"></div>
  {%- endif -%}

  <h1 class="hero-logo" id="hero-logo">
    {%- if settings.logo_light != blank -%}
      <img src="{{ settings.logo_light | image_url: width: 900 }}" alt="{{ section.settings.title | default: shop.name }}">
    {%- elsif settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 900 }}" alt="{{ section.settings.title | default: shop.name }}">
    {%- else -%}
      <span class="font-display">{{ section.settings.title | default: shop.name }}</span>
    {%- endif -%}
  </h1>

  {%- if section.settings.label != blank -%}
    <p class="hero-label">{{ section.settings.label }}</p>
  {%- endif -%}
</section>

<style>
/* Centred hero logo — fades out once the hero is scrolled past (.home-scrolled set by header JS) */
.hero-logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 90;
  margin: 0;
  line-height: 1;
  text-align: center;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.3s ease;
}
.home-scrolled .hero-logo { opacity: 0; }

.hero-logo img {
  display: block;
  height: 38rem; /* h-20 — 80px on all screen sizes */
  width: auto;
  max-width: 80vw;
}
.hero-logo .font-display {
  color: #fff;
  font-size: 48px;
  letter-spacing: var(--tracking-logo);
}
@media (min-width: 768px) {
  .hero-logo .font-display { font-size: 96px; }
}

/* Full-frame hero video */
.hero-section video.hero-media {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  object-fit: cover;
  display: block;
}
.hero-section .hero-placeholder {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  background: var(--color-muted);
}
</style>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hero video (autoplays muted, loops)",
      "info": "Upload an MP4. When set, it replaces the hero image. Use the image below as the poster/fallback."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (also used as video poster / fallback)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Overlay title",
      "default": "BLUER"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Corner label",
      "default": "CRAFTE"
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
