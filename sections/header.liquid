<header
  class="site-header{% if template.name == 'index' %} header--overlay is-top{% endif %}"
  id="site-header"
  style="--logo-w: {{ settings.logo_width | default: 110 }}px; --logo-w-mobile: {{ settings.logo_width_mobile | default: 90 }}px;"
>
  <div class="header-inner">

    <div class="header-logo" id="header-logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        {%- if template.name == 'index' -%}
          {%- comment -%}Homepage header sits over the video — same logo as inner pages, inverted to white.{%- endcomment -%}
          <img class="header-logo__img header-logo__img--invert" src="{{ 'bluer-logo-for-not-home-page-header-logo.png' | asset_url }}" alt="{{ shop.name }}">
        {%- elsif settings.logo != blank -%}
          {%- comment -%}A dark logo set in Theme settings overrides the project default.{%- endcomment -%}
          <img class="header-logo__img" src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}">
        {%- else -%}
          {%- comment -%}Project default dark logo for all non-homepage pages.{%- endcomment -%}
          <img class="header-logo__img" src="{{ 'bluer-logo-for-not-home-page-header-logo.png' | asset_url }}" alt="{{ shop.name }}">
        {%- endif -%}
      </a>
    </div>

    <div class="header-search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <label for="header-search-input" class="text-editorial-xs">Search</label>
        <input
          type="search"
          name="q"
          id="header-search-input"
          class="header-search-input"
          placeholder=""
          autocomplete="off"
          aria-label="Search"
        >
      </form>
    </div>

    <nav class="header-nav" aria-label="Site navigation">
      <button
        class="btn-reset text-editorial-xs"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
      >
        Menu
      </button>

      <a
        href="{{ routes.account_url }}"
        class="text-editorial-xs header-nav__account"
        aria-label="Account"
      >
        {%- if customer -%}Account{%- else -%}Sign In{%- endif -%}
      </a>

      <a
        href="{{ routes.cart_url }}"
        class="text-editorial-xs header-nav__bag"
        aria-label="Cart ({{ cart.item_count }} items)"
      >
        Your Bag<span class="cart-count" id="cart-count">{%- if cart.item_count > 0 %}&nbsp;({{ cart.item_count }}){% endif -%}</span>
      </a>
    </nav>

  </div>
</header>

<!-- Navigation Drawer -->
<div class="nav-drawer" id="nav-drawer" aria-hidden="true" role="dialog" aria-label="Site navigation">
  <div class="nav-drawer__header">
    <p class="nav-drawer__title">Discover</p>
    <button class="nav-drawer__close btn-reset" id="menu-close" aria-label="Close menu">×</button>
  </div>

  <div class="nav-drawer__body">
    <!-- Sidebar: category buttons -->
    <div class="nav-sidebar">
      {%- assign menu = linklists[section.settings.menu] -%}
      {%- for link in menu.links -%}
        {%- assign link_title_lower = link.title | downcase -%}
        <button
          class="nav-sidebar-btn btn-reset"
          data-panel="nav-panel-{{ forloop.index }}"
          {% if link_title_lower == 'clothing' %}data-default="true"{% endif %}
        >
          {{ link.title }}
        </button>
      {%- endfor -%}

      <div class="nav-sidebar-extras">
        <a href="/pages/about" class="nav-extra-link">About</a>
        <a href="/pages/careers" class="nav-extra-link">Careers</a>
        <a href="{{ routes.account_url }}" class="nav-extra-link">
          {%- if customer -%}Account{%- else -%}Sign In{%- endif -%}
        </a>
      </div>
    </div>

    <!-- Panels: category sub-links (single column) -->
    <div class="nav-panels">
      {%- for link in menu.links -%}
        <div class="nav-links-panel{% if forloop.first %} is-active{% endif %}" id="nav-panel-{{ forloop.index }}">
          {%- for child in link.links -%}
            <a href="{{ child.url }}" class="nav-link">{{ child.title }}</a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Collection tiles (2 x 2, right) -->
    {%- if section.settings.show_collections -%}
      <div class="nav-collections">
        {%- assign col_menu = linklists[section.settings.collections_menu] -%}
        {%- for link in col_menu.links limit: 4 -%}
          <a href="{{ link.url }}" class="nav-collection-tile">
            {%- assign coll = collections[link.object.handle] -%}
            <div class="nav-collection-tile__img">
              {%- if coll.image -%}
                <img src="{{ coll.image | image_url: width: 600 }}" alt="{{ coll.title }}" loading="lazy">
              {%- elsif coll.products.first.featured_image -%}
                <img src="{{ coll.products.first.featured_image | image_url: width: 600 }}" alt="{{ coll.title }}" loading="lazy">
              {%- endif -%}
            </div>
            <p class="nav-collection-tile__label">{{ link.title }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
<div class="nav-overlay" id="nav-overlay"></div>

<style>
/* ---- Logo ------------------------------------------------ */
/* Header logo: sized by height (h-5 / h-6 = 20px / 24px), width auto — same on every page */
.header-logo__img { display: block; width: auto; height: 20px; }
@media (min-width: 768px) { .header-logo__img { height: 28px; } }
/* Invert the black wordmark to white (homepage header over the dark video) */
.header-logo__img--invert { filter: invert(1); }
.header-logo__text {
  font-family: var(--font-display);
  font-size: 24px;
  letter-spacing: var(--tracking-logo);
  line-height: 1;
}
@media (min-width: 768px) { .header-logo__text { font-size: 28px; } }

/* ---- Transparent overlay header (homepage) --------------- */
.site-header.header--overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: transparent;
  transition: background 0.35s ease,  color 0.35s ease;
}

/* Desktop homepage: header sits just below the fixed black announcement bar (32px) */
@media (min-width: 768px) {
  .site-header.header--overlay { top: 32px; }
}

/* At the top of the page: white text, subtle scrim, logo hidden */
.site-header.header--overlay.is-top {
  color: #fff;
  background: linear-gradient(to bottom, rgba(0,0,0,0.30), rgba(0,0,0,0));
}
.site-header.header--overlay.is-top .header-search-input {
  color: #fff;
  border-bottom-color: rgba(255,255,255,0.7);
}
.site-header.header--overlay.is-top .header-search-input::placeholder { color: rgba(255,255,255,0.7); }

/* Homepage header logo: hidden over the hero, fades in once scrolled past it */
.site-header.header--overlay .header-logo {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.home-scrolled .site-header.header--overlay .header-logo {
  opacity: 1;
  pointer-events: auto;
}



@media (prefers-reduced-motion: reduce) {
  .site-header.header--overlay { transition: none; }
}

/* =====================================================================
   NAVIGATION MENU — self-contained (inlined here so it ships with the
   section markup and is never served from a stale, cached theme.css).
   Two clearly separated layouts:
     • MOBILE  (≤767px): two columns — category list | sub-links, no tiles
     • DESKTOP (≥768px): full-page mega-menu — categories | links | tiles
   ===================================================================== */

/* ---- Overlay + drawer container (shared) ---- */
.nav-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.2); z-index: 199; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
.nav-overlay.is-open { opacity: 1; pointer-events: all; }

.nav-drawer { position: fixed; top: 0; left: 0; right: 0; height: 92vh; background: var(--color-bg); z-index: 200; transform: translateY(-100%); transition: transform 0.35s ease; overflow-y: auto; }
.nav-drawer.is-open { transform: translateY(0); }

/* ---- Header chrome (shared) ---- */
.nav-drawer__header { display: flex; align-items: center; justify-content: space-between; padding: calc(env(safe-area-inset-top, 0px) + 28px) 24px 0; }
.nav-drawer__title { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
.nav-drawer__close { display: none; font-size: 28px; line-height: 1; opacity: 0.6; transition: opacity var(--transition); }
.nav-drawer__close:hover { opacity: 1; }

/* ---- Lists (shared structure; sizing set per breakpoint below) ---- */
.nav-drawer__body { --nav-font: "Helvetica Neue", Helvetica, Arial, sans-serif; display: grid; }
.nav-sidebar { display: flex; flex-direction: column; gap: 0; }
.nav-sidebar-btn { display: block; width: 100%; text-align: left; font-family: var(--nav-font); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; transition: background var(--transition); }
.nav-sidebar-btn:hover, .nav-sidebar-btn.is-active { background: rgba(217,217,217,0.24); }
.nav-sidebar-extras { display: flex; flex-direction: column; gap: 2px; border-top: 1px solid var(--color-border); padding-top: 24px; margin-top: 24px; }
.nav-extra-link { display: block; font-family: var(--nav-font); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; transition: opacity var(--transition); }
.nav-extra-link:hover { opacity: 0.6; }
.nav-panels { position: relative; }
.nav-links-panel { display: none; }
.nav-links-panel.is-active { display: flex; flex-direction: column; }
.nav-link { display: block; font-family: var(--nav-font); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; transition: opacity var(--transition); }
.nav-link:hover { opacity: 0.6; }
.nav-collection-tile { background: var(--color-bg); }
.nav-collection-tile__img { aspect-ratio: 2 / 3; overflow: hidden; background: var(--color-muted); }
.nav-collection-tile__img img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
.nav-collection-tile:hover .nav-collection-tile__img img { transform: scale(1.02); }
.nav-collection-tile__label { font-family: var(--nav-font); font-weight: 300; line-height: 1; letter-spacing: 0.1em; text-transform: uppercase; text-align: left; padding: 12px 0 0; }

/* ========================= MOBILE  (≤767px) ========================= */
@media (max-width: 767px) {
  /* Two columns: category list | sub-links. No image tiles. */
  .nav-drawer__body { grid-template-columns: 36% 1fr; column-gap: 12%; align-items: start; padding: 18px 24px 40px; }

  /* "DISCOVER" shown; no close button — the MENU button toggles open/close. */
  .nav-drawer__close { display: none; }

  /* Category list (left): the active highlight is a tall bar that bleeds to the
     screen edge, while the label text still lines up with "DISCOVER" (24px in).
     line-height matches .nav-link so CLOTHING lines up with NEW ARRIVALS, etc. */
  .nav-sidebar { margin-left: -24px; }
  .nav-sidebar-btn { font-size: 15px; line-height: 45px; padding: 0 24px; letter-spacing: 0.06em; }

  /* About / Careers / Sign In are not in the mobile menu (footer + bottom bar). */
  .nav-sidebar-extras { display: none; }

  /* Sub-links (right) — same 45px row rhythm as the category list. */
  .nav-link { font-size: 12px; line-height: 37px; letter-spacing: 0.06em; }

  /* Collection banners: a full-width row below both columns — a horizontal
     scroll that bleeds to the screen edges (~2.5 tiles visible, swipe for more). */
  .nav-collections {
    grid-column: 1 / -1;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-top: 70px;
    margin-right: -25px;
  }
  .nav-collections::-webkit-scrollbar { display: none; }
  .nav-collection-tile { flex: 0 0 40%; scroll-snap-align: start; }
  .nav-collection-tile__img { aspect-ratio: 5 / 6; }
  .nav-collection-tile__label { text-align: center; font-size: 13px; padding-top: 10px; }
}

/* ========================= DESKTOP (≥768px) ========================= */
@media (min-width: 768px) {
  /* Full-page menu that covers the header; everything fits one view, no scroll. */
  .nav-drawer { top: 0; height: 100vh; height: 100dvh; overflow: hidden; }

  /* No "DISCOVER" title; show the close (X) at the top-right. */
  .nav-drawer__header { justify-content: flex-end; padding: 18px 40px 0; }
  .nav-drawer__title { display: none; }
  .nav-drawer__close { display: block; }

  /* Three columns: categories | links | image tiles. */
  .nav-drawer__body { grid-template-columns: 230px minmax(180px, 1fr) minmax(0, 380px); gap: 16px 56px; align-items: start; padding: 14px 40px 40px; }

  .nav-sidebar-btn, .nav-extra-link { font-size: 13px; line-height: 1; padding: 9px 14px; }
  .nav-sidebar-extras { padding-top: 18px; margin-top: 16px; }
  .nav-link { font-size: 13px; line-height: 34px; }

  .nav-collections { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 8px; }
  .nav-collection-tile__img { aspect-ratio: 3 / 4; }
  .nav-collection-tile__label { font-size: 12px; padding-top: 8px; }
}
</style>

<script>
(function () {
  function init() {
    var header = document.getElementById('site-header');
    if (!header) return;
    if (!header.classList.contains('header--overlay')) return; // homepage overlay only

    var heroLogo = document.getElementById('hero-logo');
    var headerLogo = document.getElementById('header-logo');

    // Homepage without a hero logo: fall back to a normal solid header.
    if (!heroLogo || !headerLogo) {
      header.classList.remove('header--overlay', 'is-top');
      header.style.position = '';
      return;
    }

    // The header stays transparent at all times. Past ~80px of scroll, the
    // centred BLUER logo fades out and the header's top-left logo fades in
    // (both via CSS transitions on the `.home-scrolled` class).
    var root = document.documentElement;
    function onScroll() {
      root.classList.toggle('home-scrolled', window.scrollY > 80);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // The header is rendered before the hero section, so wait until the DOM is
  // parsed — otherwise #hero-logo isn't found yet and the overlay gets removed.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "Show collection tiles in menu",
      "default": true
    },
    {
      "type": "link_list",
      "id": "collections_menu",
      "label": "Collections menu (for tiles)",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
