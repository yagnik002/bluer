<div class="hc-page">
  {% render 'page-back' %}
  <div class="hc-layout">

    <!-- Left: Contact -->
    <div class="hc-contact">
      <h1 class="hc-contact__heading">CONTACT</h1>
      <p class="hc-contact__desc">{{ section.settings.contact_description | default: "We're here to make your experience seamless - Reach out for any assistance." }}</p>

      <div class="hc-contact__details">
        {%- if section.settings.phone != blank -%}
          <div class="hc-contact__item">
            <p class="hc-contact__label">PHONE</p>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="hc-contact__value">{{ section.settings.phone }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <div class="hc-contact__item">
            <p class="hc-contact__label">EMAIL</p>
            <a href="mailto:{{ section.settings.email }}" class="hc-contact__value">{{ section.settings.email }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Right: FAQs -->
    <div class="hc-faqs">
      <h2 class="hc-faqs__heading">FAQs</h2>

      <div class="faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <button class="faq-question btn-reset" aria-expanded="false">
                <span>{{ block.settings.question }}</span>
              </button>
              {%- if block.settings.answer != blank -%}
                <div class="faq-answer" hidden>
                  <p>{{ block.settings.answer }}</p>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

<style>
.hc-page {
  padding: 48px 24px 80px;
  margin: 0 auto;
}
@media (min-width: 768px) { .hc-page { padding: 64px 40px 100px; } }

.hc-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
}
@media (min-width: 768px) {
  .hc-layout { grid-template-columns: 1fr 1.8fr; gap: 80px; align-items: start; }
}

/* Contact */
.hc-contact__heading {
  font-size: 20px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 18px;
}
.hc-contact__desc {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.7;
  color: #000000;
  letter-spacing: .1em;
  margin-bottom: 32px;
}
.hc-contact__details { display: flex; gap: 32px; flex-wrap: wrap; }
.hc-contact__label {
  font-size: 16px;
  font-weight: 500;
  letter-spacing: var(--tracking-editorial);
  text-transform: uppercase;
  color: #000000;
  margin-bottom: 4px;
}
.hc-contact__value {
  font-size: 16px;
  font-weight: 300;
  color: var(--color-fg);
  transition: opacity 0.2s;
}
.hc-contact__value:hover { opacity: 0.6; }

/* FAQs */
.hc-faqs__heading {
  font-size: 20px;
  letter-spacing: 0.08em;
  font-weight: 500;
  margin-bottom: 0;
}

.faq-list { margin-top: 5px; }
.faq-item { border-bottom: 1px solid var(--color-border); }
.faq-item:first-child { border-top: 0px solid var(--color-border); }

.faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 18px 0;
  font-size: 16px;
  letter-spacing: .1em;
  font-weight: 300;
  text-align: left;
  gap: 16px;
  transition: opacity 0.2s;
  color: var(--color-fg);
}
.faq-question:hover { opacity: 0.65; }

.faq-answer { padding-bottom: 18px; }
.faq-answer p {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.75;
  letter-spacing: .1em;
  color: #000000;
}
</style>

<script>
document.querySelectorAll('.faq-question').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    var answer = item.querySelector('.faq-answer');
    var open = item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open);
    if (answer) answer.hidden = !open;
  });
});
</script>

{% schema %}
{
  "name": "Help Centre",
  "settings": [
    {
      "type": "text",
      "id": "contact_description",
      "label": "Contact description",
      "default": "We're here to make your experience seamless - Reach out for any assistance."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+91 9321466133"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "Support@bluer.co.in"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help Centre",
      "settings": {
        "phone": "+91 9321466133",
        "email": "Support@bluer.co.in"
      },
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "We provide a size guide on each of the product page - check the product you're interested in. It lists exact measurements to help you pick the best fit."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do I need to create an account to order?",
            "answer": "No, you can checkout as a guest. However, creating an account lets you track orders, save your wishlist, and speed up future checkouts."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I return my order?",
            "answer": "Yes, we accept returns within 15 days of delivery. Items must be unworn, unwashed, and in their original condition with all tags attached."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I exchange my order?",
            "answer": "Yes, exchanges for a different size or colour are subject to availability. Select 'Exchange' when initiating your return and specify your preference."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "We accept all major credit and debit cards, UPI, net banking, and prepaid wallets. Cash on delivery is available on select pin codes."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I contact the customer service?",
            "answer": "You can reach us at Support@bluer.co.in or call +91 9321466133. Our team is available Monday – Saturday, 10 AM – 7 PM IST."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I try clothes in-store?",
            "answer": "Currently BLUER operates online only. We plan to open physical stores soon — follow us on Instagram for updates."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does a return take?",
            "answer": "Once we receive and inspect your return, refunds are processed within 5–7 business days to your original payment method."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "When will I receive my order?",
            "answer": "Standard delivery takes 5–7 business days. Express delivery (2–3 business days) is available at checkout for most pin codes."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I collaborate with you?",
            "answer": "For collaboration enquiries, please email us at support@bluer.co.in with your portfolio or proposal. We'll get back to you within 3–5 business days."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I track my order?",
            "answer": "Once your order ships, you will receive a tracking link via email. You can also log in to your account and view your order status under My Purchases."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I use the coupon code?",
            "answer": "Enter your coupon code in the 'Discount' field at checkout before completing your payment. Only one code can be applied per order."
          }
        }
      ]
    }
  ]
}
{% endschema %}
