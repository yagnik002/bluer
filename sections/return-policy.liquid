<div class="policy-page policy-page--return">
  {% render 'page-back' %}
  <div class="policy-page__inner">

    <h1 class="policy-page__title">{{ section.settings.title | default: page.title }}</h1>

    {%- if section.settings.intro != blank -%}
      {%- assign intro_html = section.settings.intro | newline_to_br | replace: 'support@bluer.co.in', '<a href="mailto:support@bluer.co.in">support@bluer.co.in</a>' -%}
      <p class="policy-page__intro">{{ intro_html }}</p>
    {%- endif -%}

    <div class="policy-body">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          <h2 class="policy-section-heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

        {%- elsif block.type == 'text' -%}
          {%- assign text_html = block.settings.text | newline_to_br | replace: 'support@bluer.co.in', '<a href="mailto:support@bluer.co.in">support@bluer.co.in</a>' -%}
          <p class="policy-text" {{ block.shopify_attributes }}>{{ text_html }}</p>

        {%- elsif block.type == 'list' -%}
          <ul class="policy-list" {{ block.shopify_attributes }}>
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                {%- assign item_html = trimmed | replace: '|', '<br>' | replace: 'support@bluer.co.in', '<a href="mailto:support@bluer.co.in">support@bluer.co.in</a>' -%}
                <li>{{ item_html }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

        {%- elsif block.type == 'divider' -%}
          <hr class="policy-divider" {{ block.shopify_attributes }}>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 and page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
.policy-page--return {
  --return-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-family: var(--return-font);
  color: #000;
}
@media (min-width: 768px) { .policy-page--return { padding-top: 105px; } }
.policy-page--return .policy-page__inner { max-width: 1096px; }

.policy-page--return .policy-page__title {
  font-family: var(--return-font);
  font-size: 16px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin-bottom: 20px;
}

.policy-page--return .policy-page__intro,
.policy-page--return .policy-text,
.policy-page--return .policy-list li,
.policy-page--return .rte p,
.policy-page--return .rte li {
  font-family: var(--return-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  color: #000;
}
.policy-page--return .policy-page__intro { max-width: none; }

.policy-page--return a { color: #000; text-decoration: underline; text-underline-offset: 2px; }

.policy-page--return .policy-body { margin-top: 0; }
.policy-page--return .policy-section-heading,
.policy-page--return .rte h2 {
  font-family: var(--return-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin: 50px 0 25px;
}
.policy-page--return .policy-section-heading:first-child { margin-top: 50px; }

.policy-page--return .policy-text,
.policy-page--return .rte p { margin-bottom: 25px; }
.policy-page--return .policy-text:has(+ .policy-list) { margin-bottom: 0; }
.policy-page--return .policy-list,
.policy-page--return .rte ul,
.policy-page--return .rte ol { padding-left: 20px; margin-bottom: 25px; list-style: disc; }
.policy-page--return .policy-list li,
.policy-page--return .rte li { margin-bottom: 0; }

.policy-page--return .policy-divider { border: none; border-top: 1px solid var(--color-border); margin: 32px 0; }
</style>

{% schema %}
{
  "name": "Return Policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title (leave blank to use Shopify page title)"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Section heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "list",
      "name": "Bullet list",
      "settings": [
        {
          "type": "textarea",
          "id": "items",
          "label": "List items (one per line, use | for a line break inside an item)"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    }
  ],
  "presets": [
    { "name": "Return Policy" }
  ]
}
{% endschema %}
