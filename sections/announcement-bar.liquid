{%- if section.settings.text != blank -%}
  <div class="announcement-bar" data-announcement>
    <p>{{ section.settings.text }}</p>
  </div>
{%- endif -%}

<style>
/* Solid black bar (mobile design). Only shown on storefront-browsing templates;
   product / cart / account / content pages have their own top bars in the design. */
.announcement-bar { display: none; }
body.template-index .announcement-bar,
body.template-collection .announcement-bar,
body.template-list-collections .announcement-bar,
body.template-search .announcement-bar { display: block; }

/* Desktop homepage: solid black announcement bar pinned at the very top, with
   the transparent overlay header sitting just below it (design). */
@media (min-width: 768px) {
  body.template-index .announcement-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    height: 32px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on prepaid orders above ₹1,990"
    }
  ]
}
{% endschema %}
