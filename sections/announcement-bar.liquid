{%- if section.settings.text != blank -%}
  <div class="announcement-bar" data-announcement>
    <p>{{ section.settings.text }}</p>
  </div>
{%- endif -%}

<style>
/* Solid black bar (mobile design). Only shown on storefront-browsing templates;
   product / cart / account / content pages have their own top bars in the design. */
.announcement-bar { display: none; }
body.template-index .announcement-bar,
body.template-collection .announcement-bar,
body.template-list-collections .announcement-bar,
body.template-search .announcement-bar { display: block; }

/* Desktop homepage keeps its immersive overlay header — let the announcement sit
   transparently over the hero (its original behaviour) instead of a solid bar. */
@media (min-width: 768px) {
  body.template-index .announcement-bar {
    position: absolute;
    top: var(--header-height);
    left: 0;
    right: 0;
    z-index: 95;
    background: transparent;
    color: #fff;
    text-transform: uppercase;
    pointer-events: none;
  }
}
</style>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on prepaid orders above ₹1,990"
    }
  ]
}
{% endschema %}
