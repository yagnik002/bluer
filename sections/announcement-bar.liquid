{%- if section.settings.text != blank -%}
  <div class="announcement-bar">
    <p>{{ section.settings.text }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on prepaid orders above ₹1,990"
    }
  ]
}
{% endschema %}
