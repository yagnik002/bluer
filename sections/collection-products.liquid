{%- assign is_lookbook = false -%}
{%- if section.settings.layout == 'lookbook' -%}{%- assign is_lookbook = true -%}{%- endif -%}
{%- assign coll_title_lc = collection.title | downcase -%}
{%- assign is_crafte = false -%}
{%- if collection.handle == 'crafte' or coll_title_lc == 'crafte' -%}{%- assign is_crafte = true -%}{%- endif -%}

{%- comment -%}Collection bar + filter drawer: shown on every layout except lookbook,
   but CRAFTE (a lookbook collection) opts in so it gets back + FILTERS too. The bar
   is hidden on desktop for lookbook via .collection-bar--lookbook (mobile-only).{%- endcomment -%}
{%- if is_lookbook == false or is_crafte -%}
<!-- Collection bar -->
<div class="collection-bar{% if is_lookbook %} collection-bar--lookbook{% endif %}">
  <a href="{{ routes.root_url }}" class="collection-bar__back" aria-label="Back to home">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
    </svg>
  </a>

  <h1 class="collection-bar__title">{{ collection.title }}</h1>

  <div class="collection-bar__actions">
    <button class="collection-bar__filter-btn btn-reset" id="filter-toggle" aria-expanded="false" aria-controls="filter-drawer">FILTERS</button>

    {%- assign coll_layout = section.settings.layout | default: 'grid' -%}
    {%- if coll_layout == 'grid' -%}
      <button class="grid-view-toggle btn-reset" id="grid-view-toggle" data-view="4" aria-label="Change grid view">
        <!-- icon shows the view you'll switch TO -->
        <svg class="gvi" data-for="4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3.5" y="4.5" width="7" height="15"/><rect x="13.5" y="4.5" width="7" height="15"/></svg>
        <svg class="gvi" data-for="2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="4.5" width="14" height="15"/></svg>
        <svg class="gvi" data-for="1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7"/><rect x="13.5" y="3.5" width="7" height="7"/><rect x="3.5" y="13.5" width="7" height="7"/><rect x="13.5" y="13.5" width="7" height="7"/></svg>
      </button>
    {%- endif -%}
  </div>
</div>

<!-- Filter Drawer -->
<div class="filter-drawer" id="filter-drawer" aria-hidden="true">
  <div class="filter-drawer__overlay" id="filter-overlay"></div>
  <div class="filter-drawer__panel">
    <div class="filter-drawer__header">
      <button class="filter-drawer__back btn-reset" id="filter-close" aria-label="Close filters">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
      </button>
      <h2 class="filter-drawer__title">FILTERS</h2>
    </div>

    <div class="filter-drawer__body">
      <!-- Size filter -->
      <div class="filter-section">
        <h3 class="filter-section__title">SIZE</h3>
        <div class="filter-size-grid">
          {%- assign sizes = 'XS,S,M,L,XL,XXL,24,26,28,30,32,34' | split: ',' -%}
          {%- for size in sizes -%}
            <button class="filter-size-btn btn-reset" data-filter-size="{{ size }}">{{ size }}</button>
          {%- endfor -%}
        </div>
      </div>

      <!-- Color filter -->
      <div class="filter-section">
        <h3 class="filter-section__title">COLOR</h3>
        <ul class="filter-color-list">
          <li class="filter-color-item">
            <button class="filter-color-btn btn-reset" data-filter-color="Black">
              <span class="filter-color-swatch" style="background:#000"></span>
              <span>Black</span>
            </button>
          </li>
          <li class="filter-color-item">
            <button class="filter-color-btn btn-reset" data-filter-color="White">
              <span class="filter-color-swatch" style="background:#fff;border-color:#ccc"></span>
              <span>White</span>
            </button>
          </li>
          <li class="filter-color-item">
            <button class="filter-color-btn btn-reset" data-filter-color="Blue">
              <span class="filter-color-swatch" style="background:#2a4a7f"></span>
              <span>Blue</span>
            </button>
          </li>
          <li class="filter-color-item">
            <button class="filter-color-btn btn-reset" data-filter-color="Brown">
              <span class="filter-color-swatch" style="background:#7a5c3a"></span>
              <span>Brown</span>
            </button>
          </li>
          <li class="filter-color-item">
            <button class="filter-color-btn btn-reset" data-filter-color="Red">
              <span class="filter-color-swatch" style="background:#c0392b"></span>
              <span>Red</span>
            </button>
          </li>
          <li class="filter-color-item">
            <button class="filter-color-btn btn-reset" data-filter-color="Beige">
              <span class="filter-color-swatch" style="background:#e8d5b7"></span>
              <span>Beige</span>
            </button>
          </li>
        </ul>
        <button class="filter-show-more btn-reset" id="filter-show-more">SHOW MORE</button>
      </div>
    </div>

    <div class="filter-drawer__footer">
      <button class="btn btn--full filter-show-items-btn" id="filter-show-items">
        SHOW ITEMS ({{ collection.products_count }})
      </button>
      <button class="filter-clear-btn btn-reset" id="filter-clear">CLEAR ALL</button>
    </div>
  </div>
</div>
{%- endif -%}

{%- comment -%}Editorial hero (image + title + description): non-lookbook only —
   lookbook collections use their own intro. Hidden on desktop via CSS.{%- endcomment -%}
{%- unless is_lookbook -%}
<div class="collection-hero">
  {%- if collection.image -%}
    <div class="collection-hero__img">
      <img src="{{ collection.image | image_url: width: 1600 }}" alt="{{ collection.title | escape }}" loading="lazy">
    </div>
  {%- endif -%}
  <p class="collection-hero__title">{{ collection.title }}</p>
  {%- if collection.description != blank -%}
    <div class="collection-hero__desc rte">{{ collection.description }}</div>
  {%- endif -%}
</div>
{%- endunless -%}

{%- if collection.products_count == 0 -%}
  <div class="collection-empty">
    <p>No products found</p>
  </div>

{%- elsif section.settings.layout == 'lookbook' -%}
  <div class="lookbook{% if is_crafte %} lookbook--crafte{% endif %}" id="collection-grid">
    <div class="lookbook-intro">
      <h1 class="lookbook-intro__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lookbook-intro__desc rte">{{ collection.description }}</div>
      {%- elsif is_crafte -%}
        {%- comment -%}CRAFTE placeholder copy. Set a real description in Shopify
           admin → Collections → CRAFTE → Description to replace this.{%- endcomment -%}
        <div class="lookbook-intro__desc">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer pulvinar sodales nunc a consectetur. Ut fringilla tellus libero, non volutpat erat varius non. Mauris laoreet convallis pretium.</div>
      {%- endif -%}
    </div>

    {%- for product in collection.products -%}
      <div class="lookbook-row">
        <div class="lookbook-row__strip">
          {%- for image in product.images -%}
            <a href="{{ product.url }}" class="lookbook-row__img">
              <img src="{{ image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">
            </a>
          {%- else -%}
            {%- if product.featured_image -%}
              <a href="{{ product.url }}" class="lookbook-row__img">
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="lookbook-row__info">
          <a href="{{ product.url }}" class="lookbook-row__title">{{ product.title }}</a>
          <p class="lookbook-row__price">{{ product.price | money }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>

{%- elsif section.settings.layout == 'editorial' or section.settings.layout == 'editorial-alt' -%}
  {%- comment -%}editorial = pair,full,pair,pair,full (AFTERHOURS) · editorial-alt = full,pair,full,pair (SETS){%- endcomment -%}
  {%- if section.settings.layout == 'editorial-alt' -%}{%- assign fmod = 2 -%}{%- assign frem = 0 -%}{%- else -%}{%- assign fmod = 3 -%}{%- assign frem = 1 -%}{%- endif -%}

  {%- if section.settings.layout == 'editorial-alt' -%}
    {%- comment -%}SETS — MOBILE-ONLY design (≤767px): a full-width hero image with no
       label, then a 2-up pair of products with name/price, repeating in groups of 3.
       Hidden on desktop, where .editorial-collection below renders the unchanged layout.{%- endcomment -%}
    <div class="sets-mobile">
      {%- for product in collection.products -%}
        {%- assign pos = forloop.index0 | modulo: 3 -%}
        {%- assign sets_img_w = 700 -%}{%- if pos == 0 -%}{%- assign sets_img_w = 1100 -%}{%- endif -%}
        <div class="sets-mobile__item{% if pos == 0 %} sets-mobile__item--full{% endif %}">
          <a href="{{ product.url }}" class="sets-mobile__img">
            {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: sets_img_w }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
          </a>
          {%- unless pos == 0 -%}
            <div class="sets-mobile__info">
              <a href="{{ product.url }}" class="sets-mobile__title">{{ product.title }}</a>
              <p class="sets-mobile__price">{{ product.price | money }}</p>
            </div>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="editorial-collection{% if section.settings.layout == 'editorial-alt' %} editorial-collection--alt{% endif %}" id="collection-grid">
    {%- for product in collection.products -%}
      {%- assign mod = forloop.index0 | modulo: fmod -%}
      {%- if mod == frem -%}
        <div class="ec-block ec-block--full">
          <a href="{{ product.url }}" class="ec-img">
            {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
          </a>
          <div class="ec-info">
            <a href="{{ product.url }}" class="ec-title">{{ product.title }}</a>
            <p class="ec-price">{{ product.price | money }}</p>
          </div>
        </div>
      {%- else -%}
        {%- assign second_img = product.images[1] | default: product.featured_image -%}
        <div class="ec-block ec-block--pair">
          <a href="{{ product.url }}" class="ec-img">
            {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
          </a>
          <a href="{{ product.url }}" class="ec-img">
            {%- if second_img -%}<img src="{{ second_img | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
          </a>
          <div class="ec-info">
            <a href="{{ product.url }}" class="ec-title">{{ product.title }}</a>
            <p class="ec-price">{{ product.price | money }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

{%- else -%}
  {%- comment -%}single = one full-width product per row (AFTERHOURS); grid = 4-up with view toggle{%- endcomment -%}
  {%- if section.settings.layout == 'single' -%}{%- assign grid_modifier = 'product-grid--single' -%}{%- else -%}{%- assign grid_modifier = 'product-grid--4 gv-4' -%}{%- endif -%}
  <div class="product-grid {{ grid_modifier }}" id="collection-grid">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
      {%- assign pindex = forloop.index -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'editorial_banner' and block.settings.image != blank and block.settings.after == pindex -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="collection-banner" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="collection-banner" {{ block.shopify_attributes }}>
          {%- endif -%}
            <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.label | escape }}" loading="lazy">
            {%- if block.settings.label != blank -%}<span class="collection-banner__label">{{ block.settings.label }}</span>{%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
{%- endif -%}

<style>
/* Collection grid: keep the quick-add "+" (and its size picker) on MOBILE only;
   hide it on desktop. Scoped to #collection-grid so other pages are unaffected. */
@media (min-width: 768px) {
  #collection-grid .product-card__quick-add,
  #collection-grid .product-card__sizes { display: none; }
}

/* ===== Collection MOBILE chrome (≤767px) — matches the design =====
   Drop the main site header; the announcement bar + a sticky back / FILTERS /
   grid bar are the page chrome. Inlined here so it ships with the section. */
@media (max-width: 767px) {
  /* Remove the BLUER / search / Menu / Sign In / Your Bag header on collection. */
  body.template-collection .site-header { display: none; }

  /* Sticky announcement bar (pin the Shopify section wrapper, not just the bar). */
  body.template-collection #shopify-section-announcement-bar {
    position: sticky;
    top: 0;
    z-index: 101;
  }

  /* Sticky back + FILTERS + grid bar, sitting right below the announcement bar. */
  .collection-bar {
    position: sticky;
    top: 33.5px;
    z-index: 100;
    background: #fff;
    padding: 12px 16px;
  }

  /* Grid control beside FILTERS — toggles 2-up / 1-up (JS handles the cycle). */
  .grid-view-toggle {
    display: inline-flex;
    align-items: center;
    color: var(--color-fg);
    transition: opacity var(--transition);
  }
  .grid-view-toggle svg { width: 20px; height: 20px; display: block; }
  .grid-view-toggle .gvi[data-for="4"] { display: none; }
  .grid-view-toggle .gvi[data-for="2"] { display: block; }
  #collection-grid.gv-2 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  #collection-grid.gv-1 { grid-template-columns: 1fr; }
}

.collection-hero__img img { width: 100%; display: block; object-fit: cover; max-height: 78vh; }

/* Collection title (e.g. "SS'26") under the hero image — bold, uppercase. */
.collection-hero__title {
  padding: 22px 24px 8px;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}
/* This hero (image + "SS'26" title + description) is a MOBILE-ONLY treatment.
   Desktop keeps the standard collection layout (bar with the title + grid). */
@media (min-width: 768px) { .collection-hero { display: none; } }

.collection-hero__desc {
  padding: 0 24px 24px;
  font-size: 14px;
  line-height: 1.7;
  color: rgba(26,26,26,0.8);
  max-width: 760px;
}
@media (min-width: 768px) { .collection-hero__desc { padding: 32px 40px; } }

.collection-banner {
  position: relative;
  display: block;
  grid-column: 1 / -1;
  background: var(--color-muted);
}
.collection-banner img { width: 100%; display: block; object-fit: cover; }
.collection-banner__label {
  position: absolute;
  left: 16px;
  bottom: 16px;
  color: #fff;
  font-size: 11px;
  letter-spacing: var(--tracking-editorial);
  text-transform: uppercase;
  text-shadow: 0 1px 6px rgba(0,0,0,0.4);
}
@media (min-width: 768px) { .collection-banner__label { left: 24px; bottom: 24px; } }

/* Editorial layout — centred column; each product is a 2-up pair or a full-width image */
.editorial-collection {
  --ec-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  max-width: 880px;
  margin: 0 auto;
  padding: 8px 24px 80px;
}
@media (min-width: 768px) { .editorial-collection { padding: 8px 0 100px; } }
.ec-block { margin-bottom: 44px; }
.ec-block--pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.ec-block--pair .ec-info { grid-column: 1 / -1; }
.ec-img {
  display: block;
  aspect-ratio: 2 / 3;
  overflow: hidden;
  background: var(--color-muted);
}
.ec-img img { width: 100%; height: 100%; object-fit: cover; }
/* Hover zoom removed per design */
.ec-info { padding-top: 8px; }
.ec-title {
  display: block;
  font-family: var(--ec-font);
  font-size: 11px;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.ec-price {
  font-family: var(--ec-font);
  font-size: 11px;
  font-weight: 300;
  line-height: 1.5;
  letter-spacing: 0.08em;
  color: var(--color-muted-fg);
}

/* Lookbook layout — title + description, then a horizontal-scroll image strip per product */
.lookbook { --lookbook-font: "Helvetica Neue", Helvetica, Arial, sans-serif; padding-bottom: 80px; }
.lookbook-intro { padding: 24px 24px 4px; }
@media (min-width: 768px) { .lookbook-intro { padding: 32px 40px 4px; } }
.lookbook-intro__title {
  font-family: var(--lookbook-font);
  font-size: 16px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 14px;
}
.lookbook-intro__desc {
  font-family: var(--lookbook-font);
  font-size: 14px;
  font-weight: 300;
  line-height: 20px;
  letter-spacing: 0.1em;
  color: rgba(26,26,26,0.8);
  max-width: 640px;
}
.lookbook-intro__desc p { margin: 0; }

.lookbook-row { margin-top: 40px; padding: 0 24px; }
@media (min-width: 768px) { .lookbook-row { padding: 0 40px; } }
.lookbook-row__strip {
  display: flex;
  gap: 1px;
  background: var(--color-border);
  overflow-x: auto;
  scroll-snap-type: x proximity;
  -webkit-overflow-scrolling: touch;
  /* Hide the slider/scrollbar (design) */
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.lookbook-row__strip::-webkit-scrollbar { display: none; }
.lookbook-row__img {
  flex: 0 0 62%;
  scroll-snap-align: start;
  aspect-ratio: 354 / 615;
  overflow: hidden;
  background: var(--color-muted);
  display: block;
}
@media (min-width: 768px) { .lookbook-row__img { flex: 0 0 calc((100% - 3px) / 4); } }
.lookbook-row__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.lookbook-row__info { padding: 8px 0 0; }
.lookbook-row__title {
  display: block;
  font-family: var(--lookbook-font);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.lookbook-row__price { font-family: var(--lookbook-font); font-size: 11px; font-weight: 300; letter-spacing: 0.08em; color: var(--color-muted-fg); margin-top: 4px; }

/* ===== CRAFTE lookbook — mobile-only overrides ===== */
@media (max-width: 767px) {
  /* The back + FILTERS bar is mobile-only on lookbook (CRAFTE); see below for the
     desktop hide. Tighter strip, taller image ratio, bleed to the right edge. */
  .lookbook--crafte .lookbook-row { padding-right: 0; }
  .lookbook--crafte .lookbook-row__strip { gap: 5px; background: none; }
  .lookbook--crafte .lookbook-row__img { flex: 0 0 61%; aspect-ratio: 341 / 545; background: none; }
}
/* The opt-in bar/filter on a lookbook collection is mobile-only — hide on desktop. */
@media (min-width: 768px) { .collection-bar--lookbook { display: none; } }
</style>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Product layout",
      "options": [
        { "value": "grid", "label": "Grid (4 columns)" },
        { "value": "single", "label": "Single column (one full-width product per row)" },
        { "value": "editorial", "label": "Editorial (pair, full, pair, pair, full)" },
        { "value": "editorial-alt", "label": "Editorial alternating (full, pair, full, pair)" },
        { "value": "lookbook", "label": "Lookbook (horizontal image strips)" }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    {
      "type": "editorial_banner",
      "name": "Editorial banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Banner image" },
        { "type": "text", "id": "label", "label": "Overlay label (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "number", "id": "after", "label": "Insert after this many products", "default": 4 }
      ]
    }
  ]
}
{% endschema %}
