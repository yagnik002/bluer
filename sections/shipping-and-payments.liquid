<div class="policy-page policy-page--shipping">
  {% render 'page-back' %}
  <div class="policy-page__inner">

    <h1 class="policy-page__title">{{ section.settings.title | default: page.title }}</h1>

    {%- if section.settings.intro != blank -%}
      {%- assign intro_html = section.settings.intro | newline_to_br | replace: 'support@bluer.co.in', '<a href="mailto:support@bluer.co.in">support@bluer.co.in</a>' -%}
      <p class="policy-page__intro">{{ intro_html }}</p>
    {%- endif -%}

    <div class="policy-body">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          <h2 class="policy-section-heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

        {%- elsif block.type == 'subheading' -%}
          {%- assign sub_key = block.settings.text | strip | downcase -%}
          {%- if sub_key == 'standard orders' -%}
            <h3 class="policy-subheading policy-subheading--standard" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
          {%- elsif sub_key == 'sale orders' -%}
            <h3 class="policy-subheading policy-subheading--sale" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
          {%- else -%}
            <h3 class="policy-subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
          {%- endif -%}

        {%- elsif block.type == 'text' -%}
          {%- assign text_html = block.settings.text | newline_to_br | replace: 'support@bluer.co.in', '<a href="mailto:support@bluer.co.in">support@bluer.co.in</a>' -%}
          <p class="policy-text" {{ block.shopify_attributes }}>{{ text_html }}</p>

        {%- elsif block.type == 'list' -%}
          <ul class="policy-list" {{ block.shopify_attributes }}>
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                {%- assign item_html = trimmed | replace: '|', '<br>' | replace: 'support@bluer.co.in', '<a href="mailto:support@bluer.co.in">support@bluer.co.in</a>' -%}
                <li>{{ item_html }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

        {%- elsif block.type == 'divider' -%}
          <hr class="policy-divider" {{ block.shopify_attributes }}>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 and page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
.policy-page--shipping {
  --shipping-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-family: var(--shipping-font);
  color: #000;
}
@media (min-width: 768px) { .policy-page--shipping { padding-top: 105px; } }
.policy-page--shipping .policy-page__inner { max-width: 1080px; }

.policy-page--shipping .policy-page__title {
  font-family: var(--shipping-font);
  font-size: 16px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin-bottom: 20px;
}

.policy-page--shipping .policy-page__intro,
.policy-page--shipping .policy-text,
.policy-page--shipping .policy-list li,
.policy-page--shipping .rte p,
.policy-page--shipping .rte li {
  font-family: var(--shipping-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  color: #000;
}
.policy-page--shipping .policy-page__intro { max-width: none; }

.policy-page--shipping a { color: #000; text-decoration: underline; text-underline-offset: 2px; }

.policy-page--shipping .policy-body { margin-top: 0; }
.policy-page--shipping .policy-section-heading,
.policy-page--shipping .rte h2 {
  font-family: var(--shipping-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin: 50px 0 25px;
}
.policy-page--shipping .policy-section-heading:first-child { margin-top: 50px; }

.policy-page--shipping .policy-subheading {
  font-family: var(--shipping-font);
  font-size: 16px;
  font-weight: 400;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  color: #000;
  margin: 25px 0 0;
}

.policy-page--shipping .policy-text,
.policy-page--shipping .rte p { margin-bottom: 25px; }
.policy-page--shipping .policy-text:has(+ .policy-list) { margin-bottom: 0; }
.policy-page--shipping .policy-subheading + .policy-list { margin-top: 0; }
.policy-page--shipping .policy-list,
.policy-page--shipping .rte ul,
.policy-page--shipping .rte ol { padding-left: 20px; margin-bottom: 25px; list-style: disc; }
.policy-page--shipping .policy-list li,
.policy-page--shipping .rte li { margin-bottom: 0; }

.policy-page--shipping .policy-divider { border: none; border-top: 1px solid var(--color-border); margin: 32px 0; }

/* ---- Mobile only (design) ---- */
@media (max-width: 767px) {
  /* Remove the first "Shipping Details" heading and the "Standard Orders" subheading */
  .policy-page--shipping .policy-section-heading:first-child { display: none; }
  .policy-page--shipping .policy-subheading--standard { display: none; }

  /* Section headings */
  .policy-page--shipping .policy-section-heading,
  .policy-page--shipping .rte h2 {
    font-size: 16px;
    font-weight: 300;
    line-height: 25px;
    margin: 0 0 10px;
    padding: 0 20px;
  }

  /* Body text */
  .policy-page--shipping .policy-page__intro,
  .policy-page--shipping .policy-text,
  .policy-page--shipping .policy-list li,
  .policy-page--shipping .rte p,
  .policy-page--shipping .rte li { font-size: 12px; line-height: 15px; }

  /* "Sale Orders" shown like a section heading, with a colon */
  .policy-page--shipping .policy-subheading--sale {
    font-size: 16px;
    font-weight: 300;
    line-height: 25px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 10px;
    padding: 0 20px;
  }
  .policy-page--shipping .policy-subheading--sale::after { content: ":"; }

  /* Back button sits inline, to the left of the title */
  .policy-page--shipping .page-back-bar { padding: 0; }
  .policy-page--shipping .page-back { padding: 0; }
  .policy-page--shipping .policy-page__title {
    margin-top: -28px;
    padding-left: 40px;
    margin-bottom: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Shipping And Payments",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title (leave blank to use Shopify page title)"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Section heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Sub heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Sub heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "list",
      "name": "Bullet list",
      "settings": [
        {
          "type": "textarea",
          "id": "items",
          "label": "List items (one per line, use | for a line break inside an item)"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    }
  ],
  "presets": [
    { "name": "Shipping And Payments" }
  ]
}
{% endschema %}
