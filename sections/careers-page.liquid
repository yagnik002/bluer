<div class="careers-page">

  <!-- Mobile: hero image -->
  {%- if section.settings.image != blank -%}
    <div class="careers-hero-img">
      <img
        src="{{ section.settings.image | image_url: width: 1200 }}"
        alt="{{ section.settings.image.alt | default: 'BLUER Careers' }}"
        loading="lazy"
      >
    </div>
  {%- endif -%}

  <!-- Intro: full width -->
  <div class="careers-intro">
    <h1 class="careers-intro__heading">
      {{ section.settings.heading | default: 'Inspiring Bold Ideas' }}
    </h1>
    <p class="careers-intro__body">
      {{ section.settings.body | default: "Bluer is built on purpose, creativity, and a drive to move fashion forward. We're not here to follow trends - we're here to set them. That takes people who think differently and want their work to matter. We're looking for individuals who can help bring our vision to life. We celebrate collaboration and growth, creating an environment where ideas thrive." }}
    </p>
  </div>

  <!-- Jobs -->
  <div class="careers-jobs">
    <h2 class="careers-join-heading">{{ section.settings.join_heading | default: 'Join Us' }}</h2>
    <div class="roles-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'role' -%}
          <div class="role-card" {{ block.shopify_attributes }}>
            <div class="role-card__info">
              <p class="role-title">{{ block.settings.title }}</p>
              <p class="role-meta">{{ block.settings.location }}</p>
              <p class="role-meta">{{ block.settings.type }}</p>
            </div>
            <a
              href="mailto:{{ section.settings.careers_email | default: 'careers@bluer.co.in' }}?subject=Application — {{ block.settings.title | url_encode }}"
              class="role-apply-btn"
            >
              APPLY
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

</div>

<style>
/* ---- Careers Page ---------------------------------------- */
.careers-page {
  --careers-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-family: var(--careers-font);
  color: #000;
  padding-bottom: 80px;
}

/* Hero image — full width on mobile, hidden on desktop */
.careers-hero-img {
  width: 100%;
  margin-bottom: 40px;
}
.careers-hero-img img {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
  display: block;
}
@media (min-width: 768px) {
  .careers-hero-img { display: none; }
}

/* Intro */
.careers-intro {
  padding: 40px 24px 0;
}
@media (min-width: 768px) {
  .careers-intro { padding: 64px 40px 0; }
}

.careers-intro__heading {
  font-family: var(--careers-font);
  font-size: 20px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin-bottom: 24px;
}

.careers-intro__body {
  font-family: var(--careers-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  color: #000;
  max-width: 1024px;
}

/* Jobs layout */
.careers-jobs {
  padding: 0 24px;
}
@media (min-width: 768px) {
  .careers-jobs { padding: 0 40px; }
}

.careers-join-heading {
  font-family: var(--careers-font);
  font-size: 20px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin: 56px 0 32px;
}

/* Roles grid */
.roles-grid {
  display: grid;
  grid-template-columns: 1fr;
}
@media (min-width: 600px) {
  .roles-grid { grid-template-columns: 1fr 1fr; column-gap: 60px; }
}

.role-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 28px 0;
  border-bottom: 1px solid var(--color-border);
}

.role-card__info { display: flex; flex-direction: column; gap: 4px; }

.role-title {
  font-family: var(--careers-font);
  font-size: 16px;
  font-weight: 500;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #000;
  margin-bottom: 4px;
}

.role-meta {
  font-family: var(--careers-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 25px;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  color: #000;
}

.role-apply-btn {
  display: inline-block;
  background: #000;
  color: #fff;
  text-align: center;
  padding: 12px 28px;
  font-family: var(--careers-font);
  font-size: 14px;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  align-self: flex-start;
  margin-top: 8px;
  transition: opacity var(--transition);
}
.role-apply-btn:hover { opacity: 0.8; }
</style>

{% schema %}
{
  "name": "Careers page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Mobile hero image (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inspiring Bold Ideas"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Intro text",
      "default": "Bluer is built on purpose, creativity, and a drive to move fashion forward. We're not here to follow trends - we're here to set them. That takes people who think differently and want their work to matter. We're looking for individuals who can help bring our vision to life. We celebrate collaboration and growth, creating an environment where ideas thrive."
    },
    {
      "type": "text",
      "id": "join_heading",
      "label": "Roles section heading",
      "default": "Join Us"
    },
    {
      "type": "text",
      "id": "careers_email",
      "label": "Careers email address",
      "default": "careers@bluer.co.in"
    }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Job role",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Role title",
          "default": "Marketing Executive"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Work from home, Mumbai"
        },
        {
          "type": "text",
          "id": "type",
          "label": "Employment type",
          "default": "Full-Time"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Careers page",
      "blocks": [
        { "type": "role", "settings": { "title": "Media Buying Executive", "location": "Work from home, Mumbai", "type": "Full-Time" } },
        { "type": "role", "settings": { "title": "Human Resource Executive", "location": "Work from home, Mumbai", "type": "Full-Time" } },
        { "type": "role", "settings": { "title": "Marketing Executive", "location": "Work from home, Mumbai", "type": "Full-Time" } },
        { "type": "role", "settings": { "title": "Graphic Designer", "location": "Work from home, Mumbai", "type": "Full-Time" } }
      ]
    }
  ]
}
{% endschema %}
