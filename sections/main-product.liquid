{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="product-layout">

  <!-- Images -->
  <div class="product-images">
    {%- if product.images.size > 0 -%}
      {%- for image in product.images -%}
        <img
          src="{{ image | image_url: width: 900 }}"
          srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
          sizes="(min-width:768px) 50vw, 100vw"
          alt="{{ image.alt | default: product.title | escape }}"
          loading="{{ forloop.first | if: 'eager', 'lazy' }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
        >
      {%- endfor -%}
    {%- else -%}
      <div style="aspect-ratio:4/5;background:var(--color-muted)"></div>
    {%- endif -%}
  </div>

  <!-- Info -->
  <div class="product-info">
    <div>
      <a href="{{ collection.url }}" style="font-size:11px;letter-spacing:var(--tracking-editorial);text-transform:uppercase;opacity:0.5;display:inline-block;margin-bottom:12px;transition:opacity 0.2s">
        {{ collection.title }}
      </a>
      <h1 class="product-title">{{ product.title }}</h1>
      <p class="product-price" id="product-price">
        {{ current_variant.price | money }}
      </p>
    </div>

    {%- unless product.has_only_default_variant -%}
      <div class="product-variants">
        {%- for option in product.options_with_values -%}
          <p class="product-variants-label">{{ option.name }}</p>
          <div class="product-variants-list">
            {%- for value in option.values -%}
              {%- assign variant_for_value = product.variants | where: "option1", value | first -%}
              {%- if product.options.size >= 2 -%}
                {%- assign variant_for_value = product.variants | where: "option1", value | first -%}
                {%- if option.position == 2 -%}
                  {%- assign variant_for_value = product.variants | where: "option2", value | first -%}
                {%- elsif option.position == 3 -%}
                  {%- assign variant_for_value = product.variants | where: "option3", value | first -%}
                {%- endif -%}
              {%- endif -%}
              <button
                class="variant-btn btn-reset{% if current_variant.option1 == value or current_variant.option2 == value or current_variant.option3 == value %} is-active{% endif %}"
                data-variant-id="{{ variant_for_value.id | default: product.variants.first.id }}"
                data-price="{{ variant_for_value.price | default: product.price }}"
                data-available="{{ variant_for_value.available | default: false }}"
                {%- unless variant_for_value.available -%}disabled{%- endunless -%}
              >
                {{ value }}
              </button>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div
      id="product-form"
      data-default-variant="{{ current_variant.id }}"
    >
      <button
        id="add-to-cart-btn"
        class="product-add-btn"
        {%- unless current_variant.available -%}
        {%- endunless -%}
      >
        {%- if current_variant.available -%}
          Add to Bag
        {%- else -%}
          Sold Out
        {%- endif -%}
      </button>
    </div>

    {%- if product.description != blank -%}
      <div class="product-description">
        {{ product.description }}
      </div>
    {%- endif -%}

    <!-- Structured data -->
    <script type="application/json" id="product-data">
      {
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "title": {{ variant.title | json }},
              "price": {{ variant.price }},
              "available": {{ variant.available }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </div>

</div>

{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}
