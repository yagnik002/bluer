{%- assign current_variant = product.selected_or_first_available_variant -%}

<!-- Product top bar: back (left) · share + bag (right) — replaces the site header on product pages (Figma) -->
<div class="product-topbar">
  <button type="button" class="product-topbar__back btn-reset" id="product-back-btn" aria-label="Go back">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
  </button>
  <div class="product-topbar__actions">
    <button type="button" class="product-topbar__action btn-reset" id="product-share-btn" data-share-url="{{ shop.url }}{{ product.url }}" data-share-title="{{ product.title | escape }}" aria-label="Share">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/></svg>
    </button>
    <a href="{{ routes.cart_url }}" class="product-topbar__action product-topbar__cart" id="product-cart-link" data-open-cart aria-label="Bag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/></svg>
    </a>
  </div>
</div>

<div class="product-layout">

  <!-- Images: swipeable carousel with dots on mobile; grid on desktop -->
  <div class="product-images" id="product-gallery">
    <div class="product-gallery__track" id="product-gallery-track">
      {%- if product.images.size > 0 -%}
        {%- for image in product.images -%}
          <div class="product-gallery__cell">
            <img
              class="product-gallery__img"
              src="{{ image | image_url: width: 900 }}"
              srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
              sizes="(min-width:768px) 50vw, 100vw"
              alt="{{ image.alt | default: product.title | escape }}"
              loading="{{ forloop.first | if: 'eager', 'lazy' }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="product-gallery__cell"><div class="product-gallery__img"></div></div>
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="product-gallery__dots" id="product-gallery-dots" aria-hidden="true">
        {%- for image in product.images -%}
          <span class="product-gallery__dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}Below the gallery (left column): description, details, Complete the Look, Shipping/Returns.{%- endcomment -%}
    <div class="product-aside">
      {%- if product.description != blank -%}
        <div class="product-description">{{ product.description }}</div>
      {%- endif -%}

      {%- assign pd_composition = product.metafields.custom.composition -%}
      {%- assign pd_color = product.metafields.custom.color -%}
      {%- assign pd_model = product.metafields.custom.model -%}
      {%- assign pd_wash = product.metafields.custom.wash_care -%}
      {%- capture product_details -%}
        {%- if pd_composition != blank and pd_composition.type contains 'text' -%}<dt class="product-details__label">Composition:</dt><dd class="product-details__value">{{ pd_composition.value }}</dd>{%- endif -%}
        {%- if pd_color != blank and pd_color.type contains 'text' -%}<dt class="product-details__label">Color:</dt><dd class="product-details__value">{{ pd_color.value }}</dd>{%- endif -%}
        {%- if pd_model != blank and pd_model.type contains 'text' -%}<dt class="product-details__label">Model:</dt><dd class="product-details__value">{{ pd_model.value }}</dd>{%- endif -%}
        {%- if pd_wash != blank and pd_wash.type contains 'text' -%}<dt class="product-details__label">Wash Care:</dt><dd class="product-details__value">{{ pd_wash.value }}</dd>{%- endif -%}
      {%- endcapture -%}
      {%- assign product_details_clean = product_details | strip -%}
      {%- if product_details_clean != blank -%}
        <dl class="product-details">{{ product_details }}</dl>
      {%- endif -%}

      {%- if section.settings.look_collection != blank -%}
        {%- assign look_collection = collections[section.settings.look_collection] -%}
        {%- if look_collection != blank and look_collection.products_count > 0 -%}
          <div class="complete-the-look">
            <h2 class="section-heading">COMPLETE THE LOOK</h2>
            <div class="product-grid product-grid--2">
              {%- for look_product in look_collection.products limit: 2 -%}
                {%- render 'product-card', product: look_product -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="product-accordion">
        <button class="product-accordion__trigger btn-reset" aria-expanded="false">
          <span>SHIPPING</span>
          <svg class="accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        </button>
        <div class="product-accordion__body">
          <div class="pincode-checker">
            <div class="pincode-row">
              <input type="text" class="form-input pincode-input" id="pincode-input" placeholder="Enter Pincode" maxlength="6" pattern="[0-9]{6}">
              <button class="btn pincode-apply-btn" id="pincode-apply">APPLY</button>
            </div>
            <p class="pincode-result" id="pincode-result"></p>
          </div>
          <ul class="shipping-features">
            <li>Orders are processed within 24 hours of being placed.</li>
            <li>We offer free shipping on prepaid orders above ₹1,990.</li>
            <li>Cash on delivery charges are rupees 150 for all orders.</li>
          </ul>
          <p class="shipping-note">Delivery times are as follows: shipping to metro cities takes 3-4 working days, and to tier 1 cities takes 5-7 working days.</p>
        </div>
      </div>

      <div class="product-accordion">
        <button class="product-accordion__trigger btn-reset" aria-expanded="false">
          <span>RETURNS</span>
          <svg class="accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        </button>
        <div class="product-accordion__body">
          <ul class="shipping-features">
            <li>Easy returns within 15 days of delivery</li>
            <li>Items must be unworn, unwashed, and with original tags</li>
            <li>Refunds processed within 5–7 business days</li>
            <li><a href="/pages/return-policy">View full return policy</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Info -->
  <div class="product-info">
    <div>
      <a href="{{ collection.url }}" class="product-collection-link">
        {{ collection.title }}
      </a>
      <h1 class="product-title">{{ product.title }}</h1>
      <p class="product-price" id="product-price">
        {{ current_variant.price | money }}
      </p>
      <p class="product-tax-note">MRP inclusive of all taxes</p>
    </div>

    {%- comment -%}
      Colour swatches. Two sources:
      1) a real "Color"/"Colour" variant option (rendered in the variants loop below), or
      2) a `custom.color_swatches` colour-list metafield — used when the product has no
         colour variant, so swatches still show. Optional `custom.color_swatch_urls`
         (list.url, same order) turns each swatch into a link to that colourway's product.
    {%- endcomment -%}
    {%- assign has_color_option = false -%}
    {%- for o in product.options -%}
      {%- assign o_low = o | downcase -%}
      {%- if o_low contains 'colo' -%}{%- assign has_color_option = true -%}{%- endif -%}
    {%- endfor -%}
    {%- assign color_meta = product.metafields.custom.color_swatches -%}
    {%- if has_color_option == false -%}
      {%- if color_meta != blank and color_meta.value.size > 0 -%}
        {%- comment -%} Source: per-product `custom.color_swatches` colour-list metafield {%- endcomment -%}
        {%- assign color_urls = product.metafields.custom.color_swatch_urls.value -%}
        <div class="product-variants">
          <div class="product-option">
            <div class="product-option__header">
              <p class="product-variants-label">Color</p>
            </div>
            <div class="product-variants-list product-variants-list--color">
              {%- for c in color_meta.value -%}
                {%- assign c_url = '' -%}
                {%- if color_urls != blank and color_urls[forloop.index0] != blank -%}
                  {%- assign c_url = color_urls[forloop.index0] -%}
                {%- endif -%}
                {%- if c_url != blank -%}
                  <a href="{{ c_url }}" class="variant-color-btn{% if forloop.first %} is-active{% endif %}" style="background:{{ c }};" title="{{ c }}" aria-label="Colour {{ forloop.index }}"></a>
                {%- else -%}
                  <button type="button" class="variant-color-btn btn-reset{% if forloop.first %} is-active{% endif %}" style="background:{{ c }};" title="{{ c }}" aria-label="Colour {{ forloop.index }}"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- else -%}
        {%- comment -%} Fallback: theme-editor default swatch colours (so swatches always show) {%- endcomment -%}
        {%- capture sc_list -%}{{ section.settings.swatch_color_1 }}|{{ section.settings.swatch_color_2 }}|{{ section.settings.swatch_color_3 }}|{{ section.settings.swatch_color_4 }}|{{ section.settings.swatch_color_5 }}{%- endcapture -%}
        {%- assign sc_arr = sc_list | split: '|' -%}
        {%- assign sc_count = 0 -%}
        {%- for sc in sc_arr -%}{%- assign sc_s = sc | strip -%}{%- if sc_s != blank -%}{%- assign sc_count = sc_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if sc_count > 0 -%}
          <div class="product-variants">
            <div class="product-option">
              <div class="product-option__header">
                <p class="product-variants-label">Color</p>
              </div>
              <div class="product-variants-list product-variants-list--color">
                {%- assign first_done = false -%}
                {%- for sc in sc_arr -%}
                  {%- assign sc_t = sc | strip -%}
                  {%- if sc_t != blank -%}
                    <button type="button" class="variant-color-btn btn-reset{% unless first_done %} is-active{% endunless %}" style="background:{{ sc_t }};" title="{{ sc_t }}" aria-label="Colour"></button>
                    {%- assign first_done = true -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- unless product.has_only_default_variant -%}
      <div class="product-variants">
        {%- for option in product.options_with_values -%}
          {%- assign option_name_lower = option.name | downcase -%}
          <div class="product-option">
            <div class="product-option__header">
              <p class="product-variants-label">{{ option.name }}</p>
            </div>
            <div class="product-variants-list{%- if option_name_lower contains 'colo' %} product-variants-list--color{%- endif %}">
              {%- for value in option.values -%}
                {%- assign variant_for_value = product.variants | where: "option1", value | first -%}
                {%- if product.options.size >= 2 -%}
                  {%- if option.position == 2 -%}
                    {%- assign variant_for_value = product.variants | where: "option2", value | first -%}
                  {%- elsif option.position == 3 -%}
                    {%- assign variant_for_value = product.variants | where: "option3", value | first -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if option_name_lower contains 'colo' -%}
                  <button
                    class="variant-color-btn btn-reset{% if current_variant.option1 == value or current_variant.option2 == value or current_variant.option3 == value %} is-active{% endif %}"
                    data-variant-id="{{ variant_for_value.id | default: product.variants.first.id }}"
                    data-price="{{ variant_for_value.price | default: product.price }}"
                    data-price-formatted="{{ variant_for_value.price | default: product.price | money }}"
                    data-available="{{ variant_for_value.available | default: false }}"
                    data-color="{{ value }}"
                    title="{{ value }}"
                    style="background:{{ value | downcase | replace: ' ', '' }};"
                    {%- unless variant_for_value.available -%}disabled{%- endunless -%}
                  ></button>
                {%- else -%}
                  <button
                    class="variant-btn btn-reset{% if current_variant.option1 == value or current_variant.option2 == value or current_variant.option3 == value %} is-active{% endif %}"
                    data-variant-id="{{ variant_for_value.id | default: product.variants.first.id }}"
                    data-price="{{ variant_for_value.price | default: product.price }}"
                    data-price-formatted="{{ variant_for_value.price | default: product.price | money }}"
                    data-available="{{ variant_for_value.available | default: false }}"
                    {%- unless variant_for_value.available -%}disabled{%- endunless -%}
                  >
                    {{ value }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <!-- Stock notice -->
    {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
      <p class="product-low-stock" id="product-low-stock">Only {{ current_variant.inventory_quantity }} units left</p>
    {%- endif -%}

    <div id="product-form" data-default-variant="{{ current_variant.id }}" data-product-title="{{ product.title | escape }}">
      {%- if current_variant.available -%}
        <button id="add-to-cart-btn" class="product-add-btn">ADD TO BAG</button>
      {%- else -%}
        <button id="add-to-cart-btn" class="product-add-btn product-add-btn--notify" data-notify="true">NOTIFY ME WHEN AVAILABLE</button>
      {%- endif -%}
    </div>

    <button class="size-guide-link btn-reset" id="size-guide-btn">SIZE GUIDE</button>

    <!-- Structured data -->
    <script type="application/json" id="product-data">
      {
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "title": {{ variant.title | json }},
              "price": {{ variant.price }},
              "available": {{ variant.available }},
              "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </div>

</div>

<!-- Size Chart Modal: white panel slides in from the right; product images dimmed on the left -->
<div id="size-chart-modal" class="size-modal" aria-hidden="true" role="dialog" aria-label="Size chart">
  <div class="size-modal__bg" id="size-chart-bg" data-size-chart-close></div>
  <div class="size-modal__panel">
    <button class="size-modal__close btn-reset" id="size-chart-close" data-size-chart-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <div class="size-modal__content">
      <div class="size-modal__head">
        <h2 class="size-modal__title">Size Chart</h2>
        <span class="size-modal__product">{{ product.title }}</span>
      </div>

      {%- if product.metafields.custom.size_chart != blank and product.metafields.custom.size_chart.type contains 'rich_text' -%}
        <div class="size-modal__table size-modal__table--rte rte">{{ product.metafields.custom.size_chart }}</div>
      {%- else -%}
        <table class="size-modal__table">
          <thead><tr><th>Size</th><th>Bust</th><th>Length</th></tr></thead>
          <tbody>
            <tr><td>XS</td><td>32-34</td><td>15</td></tr>
            <tr><td>S</td><td>34-36</td><td>15.5</td></tr>
            <tr><td>M</td><td>36-38</td><td>16</td></tr>
            <tr><td>L</td><td>38-40</td><td>16</td></tr>
            <tr><td>XL</td><td>40-42</td><td>16.5</td></tr>
          </tbody>
        </table>
      {%- endif -%}

      <p class="size-modal__note-label">Note:</p>
      <p class="size-modal__note">All sizes are in inches. All the measurements are taken by hand, please consider a tolerance of 0.5 inches. The sizes mentioned above are body measurements.</p>

      <h3 class="size-modal__measure-heading">How to measure?</h3>
      <div class="size-modal__measure">
        <p class="size-modal__measure-label">Bust</p>
        <p class="size-modal__measure-text">Measure the circumference of your chest at the fullest part, placing the tape under the arms.</p>
        <p class="size-modal__measure-label">Sleeve</p>
        <p class="size-modal__measure-text">Measure from the shoulder seam to the cuff edge.</p>
        <p class="size-modal__measure-label">Length</p>
        <p class="size-modal__measure-text">Measure from the highest point of the shoulder down to the hem.</p>
      </div>
    </div>
  </div>
</div>

<!-- Featured products -->
{%- if section.settings.featured_collection != blank -%}
  {%- assign featured_collection = collections[section.settings.featured_collection] -%}
  {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
    <div class="recommended-products">
      <h2 class="section-heading">FEATURED PRODUCTS</h2>
      <div class="product-grid product-grid--4">
        {%- for fp in featured_collection.products limit: 8 -%}
          {%- render 'product-card', product: fp -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<style>
/* ---- Product top bar replaces the site header on product pages (Figma) ---- */
body.template-product #shopify-section-announcement-bar,
body.template-product .announcement-bar,
body.template-product #shopify-section-header,
body.template-product .site-header { display: none !important; }

.product-topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--header-height);
  padding: 0 24px;
  background: var(--color-bg);
}
@media (min-width: 768px) { .product-topbar { padding: 0 7vw; } }
.product-topbar__back,
.product-topbar__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-fg);
  cursor: pointer;
  transition: opacity var(--transition);
}
.product-topbar__back:hover,
.product-topbar__action:hover { opacity: 0.6; }
.product-topbar__back svg { width: 22px; height: 22px; }
.product-topbar__actions { display: flex; align-items: center; gap: 18px; }
.product-topbar__action svg { width: 20px; height: 20px; }

/* ---- Product page typography (Helvetica Neue, per design) ---- */
.product-layout { --pp-font: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.product-info .product-collection-link { font-family: var(--pp-font); letter-spacing: 0.1em; }
.product-info .product-title {
  font-family: var(--pp-font);
  font-size: 20px;
  font-weight: 300;
  line-height: 34px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.product-info .product-price {
  font-family: var(--pp-font);
  font-size: 20px;
  font-weight: 300;
  line-height: 34px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-top: 2px;
}
.product-tax-note {
  font-family: var(--pp-font);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-muted-fg);
  margin-top: 6px;
}
.product-info .product-variants-label {
  font-family: var(--pp-font);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.product-info .variant-btn { font-family: var(--pp-font); font-weight: 300; letter-spacing: 0.1em; }
.product-info .product-low-stock {
  font-family: var(--pp-font);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-muted-fg);
}
.product-info .product-add-btn {
  font-family: var(--pp-font);
  font-size: 16px;
  font-weight: 300;
  letter-spacing: 0.1em;
  text-transform: capitalize;
  height: 48px;
  padding: 0;
}
/* SIZE GUIDE — left-aligned underlined link directly under ADD TO BAG (Figma) */
.product-info .size-guide-link {
  display: inline-block;
  width: auto;
  align-self: flex-start;
  margin: -8px 0 4px;
  padding: 4px 0;
  background: transparent;
  font-family: var(--pp-font);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: left;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: opacity var(--transition);
}
.product-info .size-guide-link:hover { opacity: 0.6; }

/* ---- Left column below the gallery (description, details, Complete the Look, Shipping/Returns) ---- */
.product-aside { margin-top: 28px; }
@media (min-width: 768px) { .product-aside  }

.product-aside .product-description { font-family: var(--pp-font); font-size: 14px; line-height: 1.7; letter-spacing: 0.04em;}
.product-aside .product-details {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 6px 16px;
  margin-top: 24px;
  max-width: 560px;
}
.product-aside .product-details__label,
.product-aside .product-details__value {
  margin: 0;
  font-family: var(--pp-font);
  font-size: 14px;
  font-weight: 300;
  line-height: 22px;
  letter-spacing: 0.04em;
  color: var(--color-fg);
}

/* Complete the Look — sits in the left column, two smaller cards */
.product-aside .complete-the-look { margin-top: 40px; }
.product-aside .complete-the-look .section-heading { padding: 0 0 18px; }
.product-aside .complete-the-look .product-grid { grid-template-columns: 1fr 1fr; gap: 12px; background: transparent; }

/* Shipping / Returns accordions (left column) */
.product-aside .product-accordion { border-top: 1px solid var(--color-border); margin-top: 0; }
.product-aside .complete-the-look + .product-accordion { margin-top: 36px; }
.product-aside .product-accordion__trigger {
  font-family: var(--pp-font);
  font-size: 18px;
  font-weight: 300;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.product-aside .shipping-features li,
.product-aside .shipping-note {
  font-family: var(--pp-font);
  font-size: 15px;
  font-weight: 300;
  line-height: 26px;
  letter-spacing: 0.05em;
  text-transform: none;
  color: var(--color-fg);
}
.product-aside .shipping-note { margin-top: 14px; }

.complete-the-look .section-heading,
.recommended-products .section-heading {
  font-family: var(--pp-font);
  font-size: 16px;
  font-weight: 300;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* ---- Size chart: white panel slides in from the right, images dimmed on the left ---- */
.size-modal { position: fixed; inset: 0; z-index: 600; pointer-events: none; }
.size-modal[aria-hidden="false"] { pointer-events: all; }

/* Width of the white panel (Figma: 628px) */
.size-modal { --sc-panel: 628px; }

/* Product images fill the area to the LEFT of the panel */
.size-modal__media {
  position: absolute; top: 0; left: 0; bottom: 0;
  width: calc(100% - var(--sc-panel));
  display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
  background: var(--color-border); align-content: start; overflow: hidden;
}
.size-modal__media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--color-muted); display: block; }
.size-modal__media img:nth-child(n+3) { grid-column: 1 / -1; aspect-ratio: 676 / 912; }

/* Grey dim over the images */
.size-modal__bg {
  position: absolute; top: 0; left: 0; bottom: 0;
  width: calc(100% - var(--sc-panel));
  background: rgba(90,90,90,0.55);
  opacity: 0; transition: opacity 0.35s ease;
}
.size-modal[aria-hidden="false"] .size-modal__bg { opacity: 1; }

/* White panel — slides in from the right edge */
.size-modal__panel {
  position: absolute; top: 0; right: 0; bottom: 0;
  width: var(--sc-panel); max-width: 100%;
  background: #ffffff;
  border-left: 0.5px solid var(--color-border);
  overflow-y: auto;
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.size-modal[aria-hidden="false"] .size-modal__panel { transform: translateX(0); }

.size-modal__back, .size-modal__close { position: absolute; top: 24px; z-index: 4; color: var(--color-fg); transition: opacity var(--transition); }
.size-modal__back { left: 24px; opacity: 0; transition: opacity 0.35s ease 0.1s; }
.size-modal[aria-hidden="false"] .size-modal__back { opacity: 1; }
.size-modal__close { right: 24px; }
.size-modal[aria-hidden="false"] .size-modal__back:hover,
.size-modal__close:hover { opacity: 0.6; }
.size-modal__back svg, .size-modal__close svg { width: 24px; height: 24px; }

/* Mobile: panel covers the screen, images/back hidden */
@media (max-width: 767px) {
  .size-modal { --sc-panel: 100%; }
  .size-modal__media, .size-modal__back { display: none; }
}

.size-modal__content {
  --sc-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-family: var(--sc-font);
  padding: 72px 56px 56px;
  color: var(--color-fg);
}
@media (max-width: 899px) { .size-modal__content { padding: 72px 24px 48px; } }

.size-modal__head { display: flex; align-items: baseline; gap: 28px; margin-bottom: 40px; flex-wrap: wrap; }
.size-modal__title { font-family: var(--sc-font); font-size: 28px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
.size-modal__product { font-family: var(--sc-font); font-size: 14px; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; }

.size-modal__table { width: 100%; max-width: 520px; border-collapse: collapse; margin-bottom: 36px; font-family: var(--sc-font); }
.size-modal__table th, .size-modal__table td { border: 1px solid var(--color-fg); padding: 14px 12px; text-align: center; font-size: 14px; font-weight: 300; letter-spacing: 0.06em; }
.size-modal__table th { text-transform: uppercase; font-weight: 400; }

.size-modal__note-label { font-family: var(--sc-font); font-size: 14px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
.size-modal__note { font-family: var(--sc-font); font-size: 14px; font-weight: 300; line-height: 22px; letter-spacing: 0.04em; color: rgba(26,26,26,0.8); max-width: 520px; margin-bottom: 44px; }

.size-modal__measure-heading { font-family: var(--sc-font); font-size: 22px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 24px; }
.size-modal__measure-label { font-family: var(--sc-font); font-size: 14px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
.size-modal__measure-text { font-family: var(--sc-font); font-size: 14px; font-weight: 300; line-height: 22px; letter-spacing: 0.04em; color: rgba(26,26,26,0.8); margin-bottom: 22px; max-width: 520px; }
</style>

