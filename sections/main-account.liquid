<div class="account-page">

  <!-- Greeting -->
  <div class="account-greeting-block">
    <h1 class="account-hello">HELLO, {{ customer.first_name | upcase | default: 'THERE' }}</h1>
    <p class="account-email">{{ customer.email }}</p>
  </div>

  <!-- Featured collection editorial block -->
  {%- if section.settings.collection_image != blank -%}
    <div class="account-editorial">
      <div class="account-editorial__img">
        <img
          src="{{ section.settings.collection_image | image_url: width: 900 }}"
          alt="{{ section.settings.collection_image.alt | default: 'BLUER collection' }}"
          loading="lazy"
        >
      </div>
      <div class="account-editorial__info">
        {%- if section.settings.collection_label != blank -%}
          <p class="account-editorial__label">{{ section.settings.collection_label }}</p>
        {%- endif -%}
        {%- if section.settings.collection_title != blank -%}
          <p class="account-editorial__title">{{ section.settings.collection_title }}</p>
        {%- endif -%}
        {%- if section.settings.collection_subtitle != blank -%}
          <p class="account-editorial__subtitle">{{ section.settings.collection_subtitle }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <!-- Account nav links -->
  <ul class="account-nav-links">
    <li class="account-nav-item">
      <a href="{{ routes.account_url }}/addresses" class="account-nav-row">
        <span>ACCOUNT DETAILS</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </a>
    </li>
    <li class="account-nav-item">
      <a href="/pages/wishlist" class="account-nav-row">
        <span>WISHLIST</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </a>
    </li>
    <li class="account-nav-item">
      <a href="{{ routes.account_url }}/orders" class="account-nav-row">
        <span>MY PURCHASES</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </a>
    </li>
    <li class="account-nav-item">
      <a href="/pages/return-policy" class="account-nav-row">
        <span>RETURNS</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </a>
    </li>
  </ul>

  <a href="{{ routes.account_logout_url }}" class="account-signout">Sign out</a>
</div>

{% schema %}
{
  "name": "Account",
  "settings": [
    {
      "type": "image_picker",
      "id": "collection_image",
      "label": "Collection editorial image"
    },
    {
      "type": "text",
      "id": "collection_label",
      "label": "Collection label (e.g. NEW ARRIVALS)",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection title (e.g. CRAFTED)",
      "default": "CRAFTED"
    },
    {
      "type": "text",
      "id": "collection_subtitle",
      "label": "Collection subtitle",
      "default": "Refined essentials for the modern wardrobe."
    }
  ]
}
{% endschema %}
