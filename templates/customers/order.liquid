{% layout 'theme' %}

<div class="od-page">
  <div class="od-page__inner">

    <div class="od-id">{{ order.name }}</div>

    <div class="od-body">

      <p class="od-placed">Placed on {{ order.created_at | date: '%A, %-d %B' }}</p>

      <hr class="od-rule">

      {%- assign addr = order.shipping_address -%}
      {%- if addr -%}
        <p class="od-label">Shipping Address</p>
        <address class="od-address">
          {{ addr.name }}<br>
          {{ addr.address1 }}{% if addr.address2 != blank %}, {{ addr.address2 }}{% endif %}<br>
          {{ addr.city }} {{ addr.zip }}{% if addr.province != blank %}, {{ addr.province }}{% endif %}{% if addr.country != blank %}, {{ addr.country }}{% endif %}
          {%- if addr.phone != blank -%}<br>{{ addr.phone }}{%- endif -%}
        </address>
        <hr class="od-rule">
      {%- endif -%}

      <p class="od-count">{{ order.line_items.size }} Item(s)</p>
      {%- if order.fulfillment_status != 'fulfilled' -%}
        {%- assign est = order.created_at | date: '%s' | plus: 604800 -%}
        <p class="od-eta">Estimated delivery on {{ est | date: '%A, %-d %B' }}</p>
      {%- endif -%}

      <div class="od-items">
        {%- for li in order.line_items -%}
          {%- assign size_val = '' -%}
          {%- assign other_vals = '' -%}
          {%- for opt in li.options_with_values -%}
            {%- if opt.name == 'Size' -%}
              {%- assign size_val = opt.value -%}
            {%- elsif opt.value != 'Default Title' -%}
              {%- assign other_vals = other_vals | append: opt.value | append: ' ' -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="od-item">
            <div class="od-item__img">
              {%- if li.image -%}
                <img src="{{ li.image | image_url: width: 260 }}" alt="{{ li.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="od-item__info">
              <p class="od-item__title">{{ li.product.title | default: li.title }}</p>
              <p class="od-item__price">{{ li.final_price | money }}</p>
              {%- if other_vals != blank -%}<p class="od-item__opt">{{ other_vals | strip }}</p>{%- endif -%}
              <p class="od-item__opt">Qty: {{ li.quantity }}{% if size_val != blank %} | Size: {{ size_val }}{% endif %}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- assign now_s = 'now' | date: '%s' -%}
      {%- assign order_s = order.created_at | date: '%s' -%}
      {%- assign days = now_s | minus: order_s | divided_by: 86400 -%}
      <div class="od-notice">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 8h.01M11 12h1v4h1"/></svg>
        {%- if days > 7 -%}
          <span>The return period is over</span>
        {%- else -%}
          {%- assign close_s = order_s | plus: 604800 -%}
          <span>Eligible for return until {{ close_s | date: '%-d %B' }}</span>
        {%- endif -%}
      </div>

      <p class="od-label od-label--pay">Payment Details</p>
      <div class="od-pay">
        <div class="od-pay__row">
          <span>Payment Method</span>
          <span>{{ order.payment_gateway_names | first | default: 'Online' }}</span>
        </div>
        <div class="od-pay__row">
          <span>Subtotal (inclusive of all taxes)</span>
          <span>{{ order.subtotal_price | money }}</span>
        </div>
        <div class="od-pay__row">
          <span>Shipping Charges</span>
          <span>{{ order.shipping_price | money }}</span>
        </div>
        <div class="od-pay__total">
          <span>Total:</span>
          <span>{{ order.total_price | money }}</span>
        </div>
      </div>

      <a href="{{ order.order_status_url }}" class="btn btn--full od-invoice" target="_blank" rel="noopener">Download Invoice</a>

    </div>
  </div>
</div>

<style>
.od-page { padding: 32px 24px 80px; }
@media (min-width: 768px) { .od-page { padding: 48px 40px 100px; } }
.od-page__inner { max-width: 980px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 768px) { .od-page__inner { grid-template-columns: 180px 1fr; gap: 48px; } }

/* Figma 1:309 — order number: Helvetica Neue Medium 20px, tracking 1.8px (0.1em) */
.od-id { font-size: 20px; font-weight: 500; letter-spacing: 0.1em; color: #000; }
.od-body { max-width: 640px; }

/* Figma 1:323 — Helvetica Neue Light 16px, line-height 32px, black */
.od-placed { font-size: 16px; font-weight: 300; line-height: 32px; letter-spacing: 0.1em; color: #000000; }
.od-rule { border: none; border-top: 1px solid var(--color-border); margin: 24px 0; }

/* Figma 1:310/1:311 — SHIPPING ADDRESS / PAYMENT DETAILS: Helvetica Neue Light 16px, tracking 1.6px */
.od-label {
  font-size: 16px;
  font-weight: 300;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.od-label--pay { margin-top: 32px; }
/* Figma 1:319 — Helvetica Neue Light 16px, line-height 32px, black */
.od-address { font-style: normal; font-size: 16px; line-height: 32px; letter-spacing: 0.1em; color: #000000; }

.od-count { font-size: 16px; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; color: #000; }
.od-eta { font-size: 16px; font-weight: 300; line-height: 32px; letter-spacing: 0.1em; color: #000000; margin-top: 6px; }

.od-items { margin: 24px 0; display: flex; flex-direction: column; gap: 24px; }
.od-item { display: grid; grid-template-columns: 150px 1fr; gap: 20px; }
/* Figma 1:315-318 — line-item image 2:3 */
.od-item__img img { width: 150px; aspect-ratio: 2 / 3; object-fit: cover; background: var(--color-muted); }
/* Figma 1:324 — Helvetica Neue Light 16px, line-height 29px, uppercase */
.od-item__title { font-size: 16px; font-weight: 300; line-height: 29px; letter-spacing: 0.1em; text-transform: uppercase; color: #000; }
.od-item__price { font-size: 16px; font-weight: 300; letter-spacing: 0.1em; color: #000; margin-top: 4px; }
/* Figma 1:327 — color/qty: Helvetica Neue Light 16px, line-height 25px, capitalize, black */
.od-item__opt { font-size: 16px; font-weight: 300; line-height: 25px; letter-spacing: 0.1em; text-transform: capitalize; color: #000000; margin-top: 10px; }
.od-item__opt + .od-item__opt { margin-top: 2px; }

/* Figma 1:333/1:334 — notice: #f3f3f3 box 48px, Helvetica Neue Light 16px, black */
.od-notice {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 48px;
  background: #f3f3f3;
  padding: 0 20px;
  font-size: 16px;
  font-weight: 300;
  letter-spacing: 0.1em;
  color: #000000;
  margin: 8px 0 0;
}
.od-notice svg { width: 18px; height: 18px; flex-shrink: 0; }

.od-pay { border-top: 1px solid var(--color-border); padding-top: 16px; }
/* Figma 1:320/1:321 — Helvetica Neue Light 16px, line-height 32px, black */
.od-pay__row { display: flex; justify-content: space-between; font-size: 16px; font-weight: 300; line-height: 32px; letter-spacing: 0.1em; margin-bottom: 6px; color: #000000; }
/* Figma 1:312/1:313 — TOTAL: Helvetica Neue Medium 20px, tracking 2px (0.1em) */
.od-pay__total {
  display: flex;
  justify-content: space-between;
  font-size: 20px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 500;
  border-top: 1px solid var(--color-border);
  padding-top: 14px;
  margin-top: 6px;
}
.od-invoice { margin-top: 28px; }
</style>
