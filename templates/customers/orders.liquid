{% layout 'theme' %}

<div class="orders-page">
  <div class="orders-page__inner">

    <a href="{{ routes.account_url }}" class="orders-back" aria-label="Back to account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
    </a>

    {%- if customer.orders.size == 0 -%}
      <div class="orders-empty">
        <p class="text-editorial-sm">You have no orders yet</p>
        <a href="{{ routes.root_url }}" class="btn orders-empty__cta">Start Shopping</a>
      </div>

    {%- else -%}
      <div class="orders-list">
        {%- for order in customer.orders -%}
          <article class="order-card">
            <div class="order-card__id">
              <span class="order-card__id-label">Order ID:</span>
              <span class="order-card__id-value">{{ order.name }}</span>
            </div>

            <div class="order-card__body">
              <p class="order-card__status">
                {%- if order.fulfillment_status == 'fulfilled' -%}
                  {%- assign f = order.fulfillments.first -%}
                  Delivered{% if f.created_at %} on {{ f.created_at | date: '%d/%m/%y' }}{% endif %}
                {%- else -%}
                  {%- assign est = order.created_at | date: '%s' | plus: 604800 -%}
                  Estimated delivery on {{ est | date: '%d/%m/%y' }}
                {%- endif -%}
              </p>

              <div class="order-card__imgs">
                {%- for li in order.line_items limit: 4 -%}
                  {%- if li.image -%}
                    <img src="{{ li.image | image_url: width: 240 }}" alt="{{ li.title | escape }}" loading="lazy">
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <p class="order-card__count">{{ order.line_items.size }} Item(s)</p>

              <div class="order-card__actions">
                <a href="{{ order.customer_url }}" class="order-btn">ORDER DETAILS</a>
                {%- assign tracking = order.fulfillments.first.tracking_url -%}
                <a href="{{ tracking | default: order.customer_url }}" class="order-btn"{% if tracking %} target="_blank" rel="noopener"{% endif %}>TRACK ORDER</a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
.orders-page { padding: 32px 24px 80px; }
@media (min-width: 768px) { .orders-page { padding: 48px 40px 100px; } }
.orders-page__inner { max-width: 980px; margin: 0 auto; }

.orders-back { display: inline-flex; margin-bottom: 16px; transition: opacity var(--transition); }
.orders-back:hover { opacity: 0.6; }
.orders-back svg { width: 22px; height: 22px; }

.orders-empty { padding: 80px 0; text-align: center; border-top: 1px solid var(--color-border); }
.orders-empty__cta { margin-top: 24px; display: inline-flex; }

.order-card {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  padding: 36px 0;
  border-top: 1px solid var(--color-border);
}
.order-card:last-child { border-bottom: 1px solid var(--color-border); }
@media (min-width: 768px) {
  .order-card { grid-template-columns: 180px 1fr; gap: 48px; }
}

/* Figma 1:280 — Order ID: Helvetica Neue Light 16px, tracking 1.6px (0.1em), black */
.order-card__id-label { font-size: 16px; font-weight: 300; letter-spacing: 0.1em; color: #000000; display: block; }
/* Figma 1:271 — order number: Helvetica Neue Light 20px, tracking 1.6px */
.order-card__id-value { font-size: 20px; font-weight: 300; letter-spacing: 0.1em; color: #000000; }

/* Figma 1:274/1:278 — status: Helvetica Neue Light 16px, line-height 25px, black */
.order-card__status { font-size: 16px; font-weight: 300; line-height: 25px; letter-spacing: 0.1em; color: #000000; margin-bottom: 16px; }

.order-card__imgs { display: flex; gap: 5px; flex-wrap: wrap; }
/* Figma 1:283-296 — thumbnails 2:3 with 0.5px black border */
.order-card__imgs img {
  width: 150px;
  aspect-ratio: 2 / 3;
  object-fit: cover;
  border: 0.5px solid #000000;
  background: var(--color-muted);
}

/* Figma 1:275 — "3 Item(s)": Helvetica Neue Light 16px, black */
.order-card__count { font-size: 16px; font-weight: 300; letter-spacing: 0.1em; color: #000000; margin: 16px 0 18px; }

.order-card__actions { display: flex; gap: 12px; flex-wrap: wrap; }
/* Figma 1:297/1:300 — ORDER DETAILS / TRACK ORDER: bordered, Helvetica Neue Light 16px, tracking 1.6px */
.order-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid #000000;
  padding: 12px 28px;
  font-weight: 300;
  font-size: 16px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: background var(--transition), color var(--transition);
}
.order-btn:hover { background: #000000; color: #ffffff; }
</style>
