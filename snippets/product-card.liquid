{%- comment -%}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

{%- assign first_available = product.variants | where: "available", true | first -%}
{%- assign quick_variant = first_available | default: product.variants.first -%}
{%- assign is_bestseller = false -%}
{%- assign is_new = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_lower = tag | downcase -%}
  {%- if tag_lower == 'bestseller' -%}{%- assign is_bestseller = true -%}{%- endif -%}
  {%- if tag_lower == 'new' -%}{%- assign is_new = true -%}{%- endif -%}
{%- endfor -%}

{%- comment -%}Find the size option so quick-add can require a size before adding.{%- endcomment -%}
{%- assign size_option_position = 0 -%}
{%- for option in product.options_with_values -%}
  {%- assign on = option.name | downcase -%}
  {%- if on contains 'size' -%}{%- assign size_option_position = option.position -%}{%- endif -%}
{%- endfor -%}

<div
  class="product-card"
  data-index="{{ forloop.index0 }}"
  data-price="{{ product.price }}"
>
  <a href="{{ product.url }}" class="product-card__img-wrap" style="display:block">
    {%- if product.featured_image -%}
      <img
        class="product-card__img"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
        sizes="(min-width:1200px) 25vw, (min-width:768px) 33vw, 50vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
      >
    {%- else -%}
      <div class="product-card__img" style="background:var(--color-muted)"></div>
    {%- endif -%}

    {%- unless product.available -%}
      <div class="product-card__sold-out">
        <span>Sold Out</span>
      </div>
    {%- endunless -%}

    {%- if is_bestseller -%}
      <span class="product-badge product-badge--bestseller">Bestseller</span>
    {%- elsif is_new -%}
      <span class="product-badge product-badge--new">New</span>
    {%- endif -%}
  </a>

  {%- comment -%}
    Quick add: "+" reveals a size picker (design requires choosing a size before
    the item is added to the bag). Single-variant products add directly.
    No wishlist heart — the comps show only the "+".
    Pass show_quick_add: false (e.g. on the collection page) to omit it.
  {%- endcomment -%}
  {%- unless show_quick_add == false -%}
  {%- if product.has_only_default_variant -%}
    <button
      class="product-card__quick-add btn-reset"
      data-quick-add="{{ quick_variant.id }}"
      aria-label="Quick add {{ product.title }}"
    >+</button>
  {%- else -%}
    <button
      class="product-card__quick-add btn-reset"
      data-quick-add-toggle
      aria-label="Choose a size for {{ product.title }}"
    >+</button>
    <div class="product-card__sizes" hidden>
      {%- for v in product.variants -%}
        {%- if size_option_position == 2 -%}{%- assign v_size = v.option2 -%}
        {%- elsif size_option_position == 3 -%}{%- assign v_size = v.option3 -%}
        {%- elsif size_option_position == 1 -%}{%- assign v_size = v.option1 -%}
        {%- else -%}{%- assign v_size = v.title -%}{%- endif -%}
        <button class="product-card__size-btn btn-reset" data-add-variant="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v_size }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- endunless -%}

  <div class="product-card__info">
    <p class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </p>
    <p class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s style="margin-right:6px;opacity:0.5">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      {{ product.price | money }}
    </p>
  </div>
</div>
